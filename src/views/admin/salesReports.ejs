<div class="min-h-screen bg-slate-50/50 pb-12">
    <!-- Back Button -->
    <div class="mb-6">
        <a href="/admin/dashboard" class="inline-flex items-center gap-2 text-xs font-bold text-slate-500 hover:text-indigo-600 transition-colors bg-white px-4 py-2 rounded-xl border border-slate-100 shadow-sm">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Dashboard
        </a>
    </div>

    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Sales Analytics</h1>
            <p class="text-slate-500 mt-2 font-medium">Analyze your store performance and download reports.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <!-- Time Filter -->
            <div class="relative">
                <select id="reportFilter" onchange="handleFilterChange()" class="appearance-none bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-2xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-4 pr-10 py-3 shadow-sm transition-all hover:border-slate-300 cursor-pointer">
                    <option value="Daily">Today</option>
                    <option value="Weekly">This Week</option>
                    <option value="Monthly" selected>This Month</option>
                    <option value="Yearly">This Year</option>
                    <option value="Custom">Custom Range</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
            </div>

            <!-- Custom Date Container -->
            <div id="customDateRange" class="hidden items-center gap-2 bg-white p-1.5 rounded-2xl border border-slate-200 shadow-sm">
                <input type="date" id="dateFrom" class="bg-transparent border-0 text-sm font-bold text-slate-700 focus:ring-0 px-3 py-1">
                <span class="text-slate-300 font-bold">→</span>
                <input type="date" id="dateTo" class="bg-transparent border-0 text-sm font-bold text-slate-700 focus:ring-0 px-3 py-1">
                <button onclick="fetchReportData()" class="bg-slate-900 text-white p-2 rounded-xl hover:bg-slate-800 transition shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </button>
            </div>

            <!-- Export Buttons -->
            <div class="flex items-center gap-2">
                <button onclick="exportReport('pdf')" class="flex items-center gap-2 bg-white border border-slate-200 text-slate-700 px-5 py-3 rounded-2xl text-sm font-bold shadow-sm hover:bg-slate-50 transition-all active:scale-95">
                    <span class="text-red-500 text-lg">📄</span> PDF
                </button>
                <button onclick="exportReport('excel')" class="flex items-center gap-2 bg-slate-900 text-white px-5 py-3 rounded-2xl text-sm font-bold shadow-md hover:bg-slate-800 transition-all active:scale-95">
                    <span class="text-emerald-400 text-lg">📊</span> Excel
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-indigo-600 group-hover:scale-110 transition-transform">💰</div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Total Revenue</p>
            <h3 id="statRevenue" class="text-2xl font-black text-slate-900">₹0</h3>
            <div id="growthRevenue" class="mt-2 flex items-center gap-1 text-[10px] font-bold"></div>
        </div>

        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-amber-500 group-hover:scale-110 transition-transform">📦</div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Total Orders</p>
            <h3 id="statOrders" class="text-2xl font-black text-slate-900">0</h3>
            <div id="growthOrders" class="mt-2 flex items-center gap-1 text-[10px] font-bold"></div>
        </div>

        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-emerald-500 group-hover:scale-110 transition-transform">✨</div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Products Sold</p>
            <h3 id="statProducts" class="text-2xl font-black text-slate-900">0</h3>
            <div id="growthProducts" class="mt-2 flex items-center gap-1 text-[10px] font-bold"></div>
        </div>

        <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-rose-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-rose-500 group-hover:scale-110 transition-transform">🏷️</div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Total Discount</p>
            <h3 id="statDiscount" class="text-2xl font-black text-slate-900">₹0</h3>
            <div id="growthDiscount" class="mt-2 flex items-center gap-1 text-[10px] font-bold"></div>
        </div>
    </div>

    <!-- Main Analytics Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Sales Trend Chart -->
        <div class="lg:col-span-2 bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Revenue Trend</h2>
                    <p class="text-sm text-slate-500 font-medium">Visualizing sales performance over time.</p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                        <span class="w-3 h-3 bg-indigo-500 rounded-full"></span> Revenue
                    </div>
                    <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                        <span class="w-3 h-3 bg-slate-200 rounded-full"></span> Orders
                    </div>
                </div>
            </div>
            <div class="relative h-[350px]">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Coupon Usage Table -->
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col">
            <div class="mb-6">
                <h2 class="text-xl font-black text-slate-900">Coupon Performance</h2>
                <p class="text-sm text-slate-500 font-medium">Top performing promo codes.</p>
            </div>
            <div class="flex-1 overflow-y-auto pr-2 space-y-4" id="couponList">
                <!-- Injected via JS -->
                <div class="animate-pulse space-y-4">
                    <div class="h-16 bg-slate-50 rounded-2xl"></div>
                    <div class="h-16 bg-slate-50 rounded-2xl"></div>
                    <div class="h-16 bg-slate-50 rounded-2xl"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Orders Table -->
    <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-8 border-b border-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-xl font-black text-slate-900">Order Discount Breakdown</h2>
                <p class="text-sm text-slate-500 font-medium">Detailed view of every successful transaction.</p>
            </div>
            <div class="relative">
                <input type="text" placeholder="Search orders..." class="bg-slate-50 border-0 text-sm font-bold text-slate-700 rounded-xl pl-10 pr-4 py-2.5 focus:ring-2 focus:ring-indigo-500 w-full sm:w-64">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50">
                        <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Order ID</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Date</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Customer</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Subtotal</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Offer Disc.</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Coupon Disc.</th>
                        <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Final Amount</th>
                        <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Status</th>
                    </tr>
                </thead>
                <tbody id="orderReportBody" class="divide-y divide-slate-50">
                    <!-- Injected via JS -->
                </tbody>
            </table>
        </div>
        
        <div id="noDataMessage" class="hidden p-20 text-center">
            <div class="text-4xl mb-4">🔍</div>
            <h3 class="text-lg font-black text-slate-800">No records found</h3>
            <p class="text-slate-500">Try adjusting your filters or date range.</p>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let reportChart = null;

    document.addEventListener('DOMContentLoaded', () => {
        fetchReportData();
    });

    function handleFilterChange() {
        const filter = document.getElementById('reportFilter').value;
        const customContainer = document.getElementById('customDateRange');
        
        if (filter === 'Custom') {
            customContainer.classList.remove('hidden');
            customContainer.classList.add('flex');
        } else {
            customContainer.classList.add('hidden');
            customContainer.classList.remove('flex');
            fetchReportData();
        }
    }

    async function fetchReportData() {
        const filter = document.getElementById('reportFilter').value;
        let url = `/admin/sales-reports/data?filter=${filter}`;

        if (filter === 'Custom') {
            const from = document.getElementById('dateFrom').value;
            const to = document.getElementById('dateTo').value;
            if (!from || !to) return;
            url += `&customFrom=${from}&customTo=${to}`;
        }

        try {
            const response = await axios.get(url);
            if (response.data.success) {
                updateUI(response.data.data);
            }
        } catch (error) {
            console.error("Failed to fetch report:", error);
            Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'Data sync failed', showConfirmButton: false, timer: 3000 });
        }
    }

    function updateUI(data) {
        // Update Stats
        document.getElementById('statRevenue').innerText = `₹${data.summary.totalRevenue.toLocaleString()}`;
        document.getElementById('statOrders').innerText = data.summary.totalOrders.toLocaleString();
        document.getElementById('statProducts').innerText = data.summary.productsSold.toLocaleString();
        document.getElementById('statDiscount').innerText = `₹${data.summary.totalDiscount.toLocaleString()}`;

        // Update Growth Indicators
        updateGrowthIndicator('growthRevenue', data.summary.revenueGrowth);
        updateGrowthIndicator('growthOrders', data.summary.orderGrowth);
        updateGrowthIndicator('growthProducts', data.summary.productsGrowth);
        updateGrowthIndicator('growthDiscount', data.summary.discountGrowth);

        // Update Chart
        updateChart(data.chart);

        // Update Coupons
        const couponList = document.getElementById('couponList');
        couponList.innerHTML = '';
        if (data.couponUsage.length === 0) {
            couponList.innerHTML = `<div class="text-center py-12 text-slate-400 font-bold text-sm">No coupons used in this period.</div>`;
        } else {
            data.couponUsage.forEach(c => {
                const typeLabel = c.discountType === 'percentage' ? '%' : 'Flat';
                couponList.innerHTML += `
                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="px-2 py-0.5 bg-indigo-100 text-indigo-600 text-[8px] font-black rounded uppercase">${typeLabel}</span>
                                <p class="text-xs font-black text-slate-800 tracking-widest uppercase">${c._id}</p>
                            </div>
                            <p class="text-[10px] text-slate-400 font-bold">Used ${c.usageCount} times</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-black text-slate-900">₹${c.totalDiscount.toLocaleString()}</p>
                            <p class="text-[10px] text-slate-400 font-bold uppercase">Total Saved</p>
                        </div>
                    </div>
                `;
            });
        }

        // Update Table
        const tbody = document.getElementById('orderReportBody');
        const noData = document.getElementById('noDataMessage');
        tbody.innerHTML = '';

        if (data.orders.length === 0) {
            noData.classList.remove('hidden');
        } else {
            noData.classList.add('hidden');
            data.orders.forEach(order => {
                const date = new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                const offerDiscount = order.totalOfferDiscount || 0;
                const couponDiscount = order.discount || 0;
                
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="px-8 py-5 text-sm font-black text-slate-900">#${order.orderId || order._id.toString().slice(-6)}</td>
                        <td class="px-6 py-5 text-sm font-bold text-slate-500">${date}</td>
                        <td class="px-6 py-5 text-sm font-bold text-slate-700">${order.user ? order.user.fullName : 'Guest User'}</td>
                        <td class="px-6 py-5 text-sm font-bold text-slate-700 text-right">₹${order.subtotal.toLocaleString()}</td>
                        <td class="px-6 py-5 text-sm font-bold text-rose-500 text-right">- ₹${offerDiscount.toLocaleString()}</td>
                        <td class="px-6 py-5 text-sm font-bold text-rose-500 text-right">- ₹${couponDiscount.toLocaleString()}</td>
                        <td class="px-6 py-5 text-sm font-black text-indigo-600 text-right">₹${order.totalAmount.toLocaleString()}</td>
                        <td class="px-8 py-5">
                            <span class="px-3 py-1 text-[10px] font-black rounded-full ${getStatusClass(order.orderStatus)}">
                                ${order.orderStatus.toUpperCase()}
                            </span>
                        </td>
                    </tr>
                `;
            });
        }
    }

    function updateGrowthIndicator(elementId, growth) {
        const el = document.getElementById(elementId);
        const isPositive = growth >= 0;
        const colorClass = isPositive ? 'text-emerald-500' : 'text-rose-500';
        const arrow = isPositive ? '↑' : '↓';
        el.className = `mt-2 flex items-center gap-1 text-[10px] font-bold ${colorClass}`;
        el.innerHTML = `<span>${arrow} ${Math.abs(growth).toFixed(1)}%</span> <span class="text-slate-400">vs last period</span>`;
    }

    function getStatusClass(status) {
        switch (status) {
            case 'Delivered': return 'bg-emerald-50 text-emerald-600';
            case 'Cancelled': return 'bg-rose-50 text-rose-600';
            case 'Processing': return 'bg-amber-50 text-amber-600';
            case 'Shipped': return 'bg-blue-50 text-blue-600';
            default: return 'bg-slate-50 text-slate-600';
        }
    }

    function updateChart(chartData) {
        const ctx = document.getElementById('revenueChart').getContext('2d');
        if (reportChart) reportChart.destroy();

        const gradient = ctx.createLinearGradient(0, 0, 0, 350);
        gradient.addColorStop(0, 'rgba(79, 70, 229, 0.2)');
        gradient.addColorStop(1, 'rgba(79, 70, 229, 0)');

        reportChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartData.labels,
                datasets: [
                    {
                        label: 'Revenue',
                        data: chartData.revenue,
                        borderColor: '#4f46e5',
                        borderWidth: 4,
                        tension: 0.4,
                        fill: true,
                        backgroundColor: gradient,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#4f46e5',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Orders',
                        data: chartData.orders,
                        type: 'bar',
                        backgroundColor: '#e2e8f0',
                        borderRadius: 8,
                        barThickness: 12,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        padding: 12,
                        cornerRadius: 12,
                        titleFont: { weight: 'bold' }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { weight: 'bold', size: 10 }, color: '#94a3b8' }
                    },
                    y: {
                        position: 'left',
                        grid: { borderDash: [5, 5], color: '#f1f5f9' },
                        ticks: { font: { weight: 'bold' }, color: '#64748b' }
                    },
                    y1: {
                        position: 'right',
                        grid: { display: false },
                        ticks: { font: { weight: 'bold' }, color: '#94a3b8' }
                    }
                }
            }
        });
    }

    function exportReport(type) {
        const filter = document.getElementById('reportFilter').value;
        const from = document.getElementById('dateFrom').value;
        const to = document.getElementById('dateTo').value;
        
        let url = `/admin/sales-reports/export/${type}?filter=${filter}`;
        if (filter === 'Custom' && from && to) {
            url += `&customFrom=${from}&customTo=${to}`;
        }
        
        window.location.href = url;
    }
</script>
