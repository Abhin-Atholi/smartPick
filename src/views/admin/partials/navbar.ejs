<div class="flex items-center gap-4 sm:gap-6">
  <div class="flex flex-col hidden md:flex text-right">
    <p class="text-[10px] text-gray-400 font-bold">
      <%= new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) %>
    </p>
  </div>
  
  <div class="flex items-center gap-4 pl-0 md:pl-6 border-l-0 md:border-l border-gray-100">
    <div class="flex items-center gap-3">
        <div class="text-right hidden sm:block">
          <p class="text-sm font-black text-slate-900"><%= typeof admin !== 'undefined' && admin ? admin.fullName : 'Admin' %></p>
          <p class="text-[10px] text-indigo-500 font-black uppercase tracking-tighter">System Admin</p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-indigo-50 overflow-hidden border border-indigo-100 shadow-sm flex-shrink-0">
          <img src="<%= (typeof admin !== 'undefined' && admin && admin.profileImage) ? admin.profileImage : 'https://ui-avatars.com/api/?name=' + (typeof admin !== 'undefined' && admin ? admin.fullName : 'Admin') + '&background=6366f1&color=fff' %>" 
       alt="Admin" 
       class="w-full h-full object-cover"
       onerror="this.src='https://ui-avatars.com/api/?name=Admin&background=6366f1&color=fff'">
        </div>
    </div>
    <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>
    <a href="/admin/logout" onclick="confirmLogout(event, this.href)"
      class="w-10 h-10 flex items-center justify-center rounded-xl bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white transition-all shadow-sm hover:shadow-rose-200 hover:shadow-md" title="Logout">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
    </a>
  </div>
</div>