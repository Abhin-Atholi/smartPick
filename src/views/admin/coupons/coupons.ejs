<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Coupon Management</h2>
        <p class="text-sm text-gray-500 mt-1">Create, edit, and monitor discount coupons</p>
    </div>
    <button onclick="openAddModal()"
        class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow-lg shadow-indigo-200 transition-all active:scale-95 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Coupon
    </button>
</div>

<!-- Stats HUD -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Total Coupons</p>
                <h4 class="text-2xl font-black text-slate-800 mt-1"><%= stats.totalCoupons %></h4>
            </div>
        </div>
    </div>
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div>
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Active Now</p>
                <h4 class="text-2xl font-black text-emerald-600 mt-1"><%= stats.activeCoupons %></h4>
            </div>
        </div>
    </div>
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-rose-50 rounded-xl flex items-center justify-center text-rose-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <div>
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Expired</p>
                <h4 class="text-2xl font-black text-rose-600 mt-1"><%= stats.expiredCoupons %></h4>
            </div>
        </div>
    </div>
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
            </div>
            <div>
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Total Redemptions</p>
                <h4 class="text-2xl font-black text-slate-800 mt-1"><%= stats.totalUsage %></h4>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search -->
<div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-6 flex flex-col md:flex-row gap-4 justify-between">
    <form action="/admin/coupons" method="GET" class="flex flex-1 flex-col sm:flex-row gap-4" id="filterForm">
        <div class="relative flex-1 w-full sm:max-w-md">
            <input type="text" name="search" value="<%= search %>" placeholder="Search by Coupon Code..."
                class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-base sm:text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-semibold outline-none text-slate-700 placeholder-gray-400">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
        </div>
        <select name="status" onchange="document.getElementById('filterForm').submit()"
            class="bg-gray-50 border border-gray-200 text-slate-700 text-base sm:text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 font-bold outline-none cursor-pointer">
            <option value="">All Statuses</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired</option>
        </select>
        <% if(status) { %>
            <a href="/admin/coupons" class="px-4 py-2.5 text-base sm:text-sm font-bold text-gray-500 bg-gray-100 hover:bg-gray-200 rounded-xl transition w-full sm:w-auto text-center">Clear Filters</a>
        <% } %>
    </form>

    <% if(search && search.length > 0) { %>
        <div class="mt-4 flex items-center gap-2">
            <span class="text-xs text-gray-500">Results for:</span>
            <span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full border border-indigo-200">
                "<%= search %>"
                <a href="/admin/coupons?status=<%= status %>" class="text-indigo-400 hover:text-indigo-600 ml-0.5" title="Clear">✕</a>
            </span>
        </div>
    <% } %>
</div>

<!-- Coupons Table -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-600 whitespace-nowrap">
            <thead class="text-xs uppercase bg-gray-50 text-gray-400 font-black tracking-wider border-b border-gray-100">
                <tr>
                    <th scope="col" class="px-6 py-4">Code</th>
                    <th scope="col" class="px-6 py-4">Type & Value</th>
                    <th scope="col" class="px-6 py-4">Min Pur. / Max Dis.</th>
                    <th scope="col" class="px-6 py-4">Usage HUD</th>
                    <th scope="col" class="px-6 py-4">Expiry Date</th>
                    <th scope="col" class="px-6 py-4">Status</th>
                    <th scope="col" class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if(coupons.length > 0) { %>
                    <% coupons.forEach(coupon => { %>
                        <tr class="hover:bg-indigo-50/30 transition-colors group">
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-gray-100 text-slate-800 font-mono font-bold rounded-lg border border-gray-200 text-xs tracking-wider">
                                    <%= coupon.code %>
                                </span>
                                <% if(coupon.description) { %>
                                    <p class="text-xs text-gray-400 font-semibold mt-1 truncate max-w-[150px]" title="<%= coupon.description %>"><%= coupon.description %></p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-black text-slate-800 capitalize"><%= coupon.discountType %></span>
                                <p class="text-xs font-bold text-indigo-600 mt-0.5">
                                    <%= coupon.discountType === 'percentage' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %>
                                </p>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-xs font-bold text-gray-500">Min: <span class="text-slate-800">₹<%= coupon.minimumAmount %></span></p>
                                <% if(coupon.discountType === 'percentage') { %>
                                    <p class="text-xs font-bold text-gray-500 mt-0.5">Max Dis: <span class="text-slate-800">₹<%= coupon.maximumDiscount %></span></p>
                                <% } else { %>
                                    <p class="text-xs font-bold text-gray-300 mt-0.5">Max Dis: N/A</p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <div class="w-full bg-gray-100 rounded-full h-1.5 mb-1 max-w-[100px]">
                                    <% const usagePercent = Math.min((coupon.usedCount / coupon.usageLimit) * 100, 100); %>
                                    <div class="h-1.5 rounded-full <%= usagePercent >= 100 ? 'bg-red-500' : 'bg-indigo-500' %>" style="width: <%= usagePercent %>%"></div>
                                </div>
                                <span class="text-[10px] font-bold text-gray-400"><%= coupon.usedCount %> / <%= coupon.usageLimit %> Used</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm font-semibold text-slate-700">
                                    <%= new Date(coupon.expiryDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                </p>
                                <% if(coupon.dynamicStatus === 'Expired') { %>
                                    <p class="text-[10px] text-red-500 font-bold uppercase mt-0.5">Expired</p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold
                                    <%= coupon.dynamicStatus === 'Active' ? 'bg-green-50 text-green-700 border border-green-200' :
                                        coupon.dynamicStatus === 'Expired' ? 'bg-red-50 text-red-700 border border-red-200' :
                                        'bg-gray-100 text-gray-600 border border-gray-200' %>">
                                    <span class="w-1.5 h-1.5 rounded-full
                                        <%= coupon.dynamicStatus === 'Active' ? 'bg-green-500' :
                                            coupon.dynamicStatus === 'Expired' ? 'bg-red-500' :
                                            'bg-gray-400' %>">
                                    </span>
                                    <%= coupon.dynamicStatus %>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <button data-coupon="<%= JSON.stringify(coupon) %>" onclick="openEditModal(JSON.parse(this.getAttribute('data-coupon')))" 
                                        class="p-2 rounded-xl transition <%= coupon.dynamicStatus === 'Expired' ? 'bg-gray-50 text-gray-400 cursor-not-allowed' : 'bg-indigo-50 text-indigo-600 hover:bg-indigo-100' %>" title="Edit" <%= coupon.dynamicStatus === 'Expired' ? 'disabled' : '' %>>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button onclick="toggleCouponStatus('<%= coupon._id %>', <%= coupon.isActive %>)" 
                                        class="p-2 rounded-xl transition <%= coupon.isActive ? 'bg-yellow-50 text-yellow-600 hover:bg-yellow-100' : 'bg-green-50 text-green-600 hover:bg-green-100' %>" title="<%= coupon.isActive ? 'Deactivate' : 'Activate' %>">
                                        <% if(coupon.isActive) { %>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                                        <% } else { %>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        <% } %>
                                    </button>
                                    <button onclick="deleteCoupon('<%= coupon._id %>')" 
                                        class="p-2 rounded-xl bg-red-50 text-red-500 hover:bg-red-100 transition" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="px-6 py-10 text-center">
                            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-50 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            </div>
                            <h3 class="text-sm font-bold text-slate-800">No coupons found</h3>
                            <p class="text-xs text-gray-500 mt-1">Try adjusting your search or filter to find what you're looking for.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-gray-100 bg-white flex justify-end">
            <nav class="flex items-center gap-1">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %><%= search ? '&search='+search : '' %><%= status ? '&status='+status : '' %>" 
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold transition-colors
                        <%= currentPage === i ? 'bg-indigo-600 text-white shadow-sm' : 'text-gray-500 hover:bg-gray-100 hover:text-slate-800' %>">
                        <%= i %>
                    </a>
                <% } %>
            </nav>
        </div>
    <% } %>
</div>

<!-- Coupon Modal (Add/Edit) -->
<div id="couponModal" class="fixed inset-0 z-50 hidden bg-gray-900/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl transform transition-all duration-300 scale-95 opacity-0 translate-y-4 max-h-[90dvh] flex flex-col" id="couponModalContent">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 rounded-t-2xl shrink-0">
            <h3 id="modalTitle" class="text-lg font-black text-slate-800">Add New Coupon</h3>
            <button onclick="closeModal()" class="text-gray-400 hover:text-red-500 transition-colors p-1 rounded-lg hover:bg-red-50">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        
        <form id="couponForm" class="p-6 overflow-y-auto">
            <input type="hidden" id="couponId" name="couponId">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                <!-- Code -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Coupon Code <span class="text-red-500">*</span></label>
                    <input type="text" id="code" name="code" placeholder="e.g. SUMMER50" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-mono font-bold uppercase transition-all">
                    <p id="codeError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                    <p id="codeLockText" class="text-[10px] text-orange-500 font-bold mt-1 hidden flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Locked: Coupon already in use</p>
                </div>
                
                <!-- Description -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Description</label>
                    <input type="text" id="description" name="description" placeholder="Brief description..." class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-semibold transition-all">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                <!-- Discount Type -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Discount Type <span class="text-red-500">*</span></label>
                    <select id="discountType" name="discountType" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                        <option value="flat">Flat Amount (₹)</option>
                        <option value="percentage">Percentage (%)</option>
                    </select>
                </div>
                
                <!-- Discount Value -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Discount Value <span class="text-red-500">*</span></label>
                    <input type="number" id="discountValue" name="discountValue" min="1" step="1" placeholder="e.g. 50" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="discountValueError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                    <p id="discountWarning" class="text-[10px] text-orange-500 font-bold mt-1 hidden">⚠️ High discount! Verify profit margins.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
                <!-- Minimum Purchase -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Min Purchase (₹) <span class="text-red-500">*</span></label>
                    <input type="number" id="minimumAmount" name="minimumAmount" min="0" step="1" value="0" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="minimumAmountError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>

                <!-- Maximum Discount (Percentage only) -->
                <div id="maxDiscountContainer" class="opacity-50 pointer-events-none transition-all">
                    <label class="block text-[11px] font-black text-gray-500 uppercase tracking-wider mb-2">Max Discount (₹)</label>
                    <input type="number" id="maximumDiscount" name="maximumDiscount" min="1" step="1" placeholder="Required for %" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all" disabled>
                    <p id="maximumDiscountError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
                
                <!-- Usage Limit -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Total Limit <span class="text-red-500">*</span></label>
                    <input type="number" id="usageLimit" name="usageLimit" min="1" step="1" placeholder="e.g. 100" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="usageLimitError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                <!-- Start Date -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Start Date <span class="text-red-500">*</span></label>
                    <input type="date" id="startDate" name="startDate" min="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                    <p id="startDateError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
                <!-- Expiry Date -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Expiry Date <span class="text-red-500">*</span></label>
                    <input type="date" id="expiryDate" name="expiryDate" min="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                    <p id="expiryDateError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
            </div>

            <!-- Active Status Toggle -->
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200 mb-5">
                <div>
                    <p class="text-sm font-black text-gray-800">Active Status</p>
                    <p class="text-[11px] text-gray-400 font-semibold mt-0.5">Inactive coupons cannot be applied by users</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="isActive" name="isActive" class="sr-only peer" checked>
                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl font-bold text-sm text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">Cancel</button>
                <button type="submit" id="submitBtn" class="px-6 py-2.5 rounded-xl font-bold text-sm text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all active:scale-95">Save Coupon</button>
            </div>
        </form>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // ── DOM references ────────────────────────────────────────────────────────
    const modal          = document.getElementById('couponModal');
    const modalContent   = document.getElementById('couponModalContent');
    const form           = document.getElementById('couponForm');
    const discountTypeEl = document.getElementById('discountType');
    const maxDiscountBox = document.getElementById('maxDiscountContainer');
    const maxDiscountEl  = document.getElementById('maximumDiscount');
    const codeEl         = document.getElementById('code');
    const codeLockText   = document.getElementById('codeLockText');
    const discountValEl  = document.getElementById('discountValue');
    const isActiveEl     = document.getElementById('isActive');

    // ── Validation helpers ────────────────────────────────────────────────────
    const CouponV = {
        _show(fieldId, errorId, msg) {
            const f = document.getElementById(fieldId);
            const e = document.getElementById(errorId);
            if (f) { f.classList.add('border-red-500'); f.classList.remove('border-gray-200'); }
            if (e) { e.textContent = msg; e.classList.remove('hidden'); }
        },
        _clear(fieldId, errorId) {
            const f = document.getElementById(fieldId);
            const e = document.getElementById(errorId);
            if (f) { f.classList.remove('border-red-500'); f.classList.add('border-gray-200'); }
            if (e) { e.textContent = ''; e.classList.add('hidden'); }
        },
        clearAll() {
            document.querySelectorAll('#couponForm .error-msg').forEach(e => { e.textContent = ''; e.classList.add('hidden'); });
            document.querySelectorAll('#couponForm input, #couponForm select').forEach(el => {
                el.classList.remove('border-red-500'); el.classList.add('border-gray-200');
            });
        },
        // Map backend `errors` object (from Joi middleware) to field-level UI
        applyBackendErrors(errors) {
            const fieldMap = {
                code:            ['code',            'codeError'],
                discountValue:   ['discountValue',   'discountValueError'],
                minimumAmount:   ['minimumAmount',   'minimumAmountError'],
                maximumDiscount: ['maximumDiscount', 'maximumDiscountError'],
                usageLimit:      ['usageLimit',      'usageLimitError'],
                expiryDate:      ['expiryDate',      'expiryDateError'],
                startDate:       ['startDate',       'startDateError'],
            };
            Object.entries(errors).forEach(([key, msg]) => {
                const ids = fieldMap[key];
                if (ids) this._show(ids[0], ids[1], msg);
            });
        },

        code() {
            const v = codeEl.value.trim();
            if (!v)          return this._show('code','codeError','Coupon code is required.'), false;
            if (v.length<3)  return this._show('code','codeError','Code must be at least 3 characters.'), false;
            if (/^\d+$/.test(v)) return this._show('code','codeError','Code cannot be only numbers.'), false;
            if (v.length>20) return this._show('code','codeError','Code cannot exceed 20 characters.'), false;
            if (!/^[A-Z0-9_-]+$/.test(v)) return this._show('code','codeError','Only letters, numbers, - and _ allowed.'), false;
            this._clear('code','codeError'); return true;
        },
        discountValue() {
            const dType = discountTypeEl.value;
            const v = parseFloat(discountValEl.value);
            const warningEl = document.getElementById('discountWarning');
            warningEl.classList.add('hidden');
            
            if (!discountValEl.value || isNaN(v)) return this._show('discountValue','discountValueError','Discount value is required.'), false;
            if (v < 1) return this._show('discountValue','discountValueError','Must be at least 1.'), false;
            if (dType === 'percentage') {
                if (v > 90) return this._show('discountValue','discountValueError','Percentage cannot exceed 90%.'), false;
                if (v >= 50) warningEl.classList.remove('hidden');
            }
            this._clear('discountValue','discountValueError'); return true;
        },
        minimumAmount() {
            const dType = discountTypeEl.value;
            const dVal  = parseFloat(discountValEl.value);
            const v     = parseFloat(document.getElementById('minimumAmount').value);
            const raw   = document.getElementById('minimumAmount').value;
            if (raw === '') return this._show('minimumAmount','minimumAmountError','Minimum purchase amount is required.'), false;
            if (v < 0)      return this._show('minimumAmount','minimumAmountError','Cannot be negative.'), false;
            if (dType === 'flat' && !isNaN(dVal) && dVal >= v)
                return this._show('minimumAmount','minimumAmountError','Must be greater than the flat discount value.'), false;
            this._clear('minimumAmount','minimumAmountError'); return true;
        },
        maximumDiscount() {
            if (discountTypeEl.value !== 'percentage') { this._clear('maximumDiscount','maximumDiscountError'); return true; }
            const v = parseFloat(maxDiscountEl.value);
            if (!maxDiscountEl.value || isNaN(v)) return this._show('maximumDiscount','maximumDiscountError','Required for percentage type.'), false;
            if (v < 1) return this._show('maximumDiscount','maximumDiscountError','Must be at least ₹1.'), false;
            this._clear('maximumDiscount','maximumDiscountError'); return true;
        },
        usageLimit() {
            const v = parseInt(document.getElementById('usageLimit').value);
            if (!document.getElementById('usageLimit').value || isNaN(v)) return this._show('usageLimit','usageLimitError','Usage limit is required.'), false;
            if (v < 1) return this._show('usageLimit','usageLimitError','Must be at least 1.'), false;
            this._clear('usageLimit','usageLimitError'); return true;
        },
        expiryDate() {
            const startStr = document.getElementById('startDate').value;
            const expiryStr = document.getElementById('expiryDate').value;
            const today = new Date();
            today.setHours(0,0,0,0);

            let ok = true;
            if (!expiryStr) {
                this._show('expiryDate','expiryDateError','Expiry date is required.'); ok = false;
            } else if (new Date(expiryStr) < today) {
                this._show('expiryDate','expiryDateError','Expiry date cannot be in the past.'); ok = false;
            } else {
                this._clear('expiryDate','expiryDateError');
            }

            if (!startStr) {
                this._show('startDate','startDateError','Start date is required.'); ok = false;
            } else if (new Date(startStr) < today) {
                this._show('startDate','startDateError','Start date cannot be in the past.'); ok = false;
            } else if (startStr && expiryStr && new Date(startStr) > new Date(expiryStr)) {
                this._show('startDate','startDateError','Start date must be on or before expiry date.'); ok = false;
            } else {
                this._clear('startDate','startDateError');
            }

            return ok;
        },
        all(isEdit) {
            const checks = [
                isEdit ? true : this.code(),
                this.discountValue(),
                this.minimumAmount(),
                this.maximumDiscount(),
                this.usageLimit(),
                this.expiryDate()
            ];
            if (!isEdit) checks.unshift(this.code());
            return checks.every(Boolean);
        }
    };

    // ── Discount type toggle ──────────────────────────────────────────────────
    discountTypeEl.addEventListener('change', function () {
        if (this.value === 'percentage') {
            maxDiscountBox.classList.remove('opacity-50','pointer-events-none');
            maxDiscountEl.disabled = false;
            discountValEl.placeholder = 'e.g. 15  (Max 90%)';
            discountValEl.max = 90;
        } else {
            maxDiscountBox.classList.add('opacity-50','pointer-events-none');
            maxDiscountEl.disabled = true;
            maxDiscountEl.value = '';
            discountValEl.placeholder = 'e.g. 500  (Flat ₹)';
            discountValEl.removeAttribute('max');
        }
        CouponV.discountValue();
        CouponV.minimumAmount();
        CouponV.maximumDiscount();
    });

    // ── Live validation listeners ─────────────────────────────────────────────
    codeEl.addEventListener('input',  () => { codeEl.value = codeEl.value.replace(/\s+/g,'').toUpperCase(); CouponV.code(); });
    discountValEl.addEventListener('input', () => { CouponV.discountValue(); CouponV.minimumAmount(); });
    document.getElementById('minimumAmount').addEventListener('input', () => CouponV.minimumAmount());
    maxDiscountEl.addEventListener('input', () => CouponV.maximumDiscount());
    document.getElementById('usageLimit').addEventListener('input', () => CouponV.usageLimit());
    document.getElementById('expiryDate').addEventListener('change', () => CouponV.expiryDate());
    document.getElementById('startDate').addEventListener('change',  () => CouponV.expiryDate());

    // ── Modal helpers ─────────────────────────────────────────────────────────
    function _openModal() {
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalContent.classList.remove('scale-95','opacity-0','translate-y-4');
        }, 10);
    }
    function closeModal() {
        modal.classList.add('opacity-0');
        modalContent.classList.add('scale-95','opacity-0','translate-y-4');
        setTimeout(() => modal.classList.add('hidden'), 300);
    }
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    const pad = n => n < 10 ? '0'+n : n;
    const toDateStr = d => {
        const dt = new Date(d);
        return `${dt.getFullYear()}-${pad(dt.getMonth()+1)}-${pad(dt.getDate())}`;
    };

    function openAddModal() {
        form.reset();
        document.getElementById('couponId').value = '';
        document.getElementById('modalTitle').textContent = 'Add New Coupon';
        document.getElementById('startDate').value = toDateStr(new Date());
        isActiveEl.checked = true;
        codeEl.readOnly = false;
        codeEl.classList.remove('bg-gray-200','text-gray-500','border-transparent');
        codeLockText.classList.add('hidden');
        discountTypeEl.disabled = false;
        discountTypeEl.classList.remove('bg-gray-200','text-gray-500');
        discountTypeEl.dispatchEvent(new Event('change'));
        CouponV.clearAll();
        _openModal();
    }

    function openEditModal(coupon) {
        form.reset();
        document.getElementById('couponId').value = coupon._id;
        document.getElementById('modalTitle').textContent = 'Edit Coupon: ' + coupon.code;
        codeEl.value = coupon.code;
        document.getElementById('description').value = coupon.description || '';
        discountTypeEl.value = coupon.discountType;
        discountValEl.value = coupon.discountValue;
        document.getElementById('minimumAmount').value = coupon.minimumAmount;
        document.getElementById('usageLimit').value = coupon.usageLimit;
        if (coupon.maximumDiscount) maxDiscountEl.value = coupon.maximumDiscount;
        document.getElementById('expiryDate').value = toDateStr(coupon.expiryDate);
        if (coupon.startDate) document.getElementById('startDate').value = toDateStr(coupon.startDate);
        // ── Toggle: always set explicitly from data, never from FormData ──────
        isActiveEl.checked = coupon.isActive !== false;

        if (coupon.usedCount > 0) {
            codeEl.readOnly = true;
            codeEl.classList.add('bg-gray-200','text-gray-500','border-transparent');
            codeLockText.classList.remove('hidden');
            discountTypeEl.disabled = true;
            discountTypeEl.classList.add('bg-gray-200','text-gray-500');
        } else {
            codeEl.readOnly = false;
            codeEl.classList.remove('bg-gray-200','text-gray-500','border-transparent');
            codeLockText.classList.add('hidden');
            discountTypeEl.disabled = false;
            discountTypeEl.classList.remove('bg-gray-200','text-gray-500');
        }

        discountTypeEl.dispatchEvent(new Event('change'));
        CouponV.clearAll();
        _openModal();
    }

    // ── Form submit ───────────────────────────────────────────────────────────
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id     = document.getElementById('couponId').value;
        const isEdit = !!id;

        CouponV.clearAll();
        if (!CouponV.all(isEdit)) return;

        const btn = document.getElementById('submitBtn');
        btn.disabled = true; btn.textContent = 'Saving…';

        // ── Build payload manually so isActive is ALWAYS a proper boolean ────
        // (FormData silently omits unchecked checkboxes → this was the bug)
        const payload = {
            code:            codeEl.value.trim().toUpperCase(),
            description:     document.getElementById('description').value.trim(),
            discountType:    discountTypeEl.value,
            discountValue:   parseFloat(discountValEl.value),
            minimumAmount:   parseFloat(document.getElementById('minimumAmount').value),
            maximumDiscount: discountTypeEl.value === 'percentage' ? parseFloat(maxDiscountEl.value) : null,
            usageLimit:      parseInt(document.getElementById('usageLimit').value),
            startDate:       document.getElementById('startDate').value || null,
            expiryDate:      document.getElementById('expiryDate').value,
            isActive:        isActiveEl.checked  // ← explicit boolean, never omitted
        };

        try {
            const url = isEdit ? `/admin/coupons/edit/${id}` : '/admin/coupons/add';
            const res = await (isEdit ? axios.patch(url, payload) : axios.post(url, payload));
            if (res.data.success) {
                await Swal.fire({ icon:'success', title:'Saved!', text: res.data.message, timer:1500, showConfirmButton:false });
                window.location.reload();
            }
        } catch (err) {
            const data = err.response?.data;
            if (data?.errors) {
                // Map structured Joi field errors to the form UI
                CouponV.applyBackendErrors(data.errors);
                Swal.fire({ icon:'warning', title:'Please fix the errors', text:'Check the highlighted fields.', timer:2500, showConfirmButton:false });
            } else {
                Swal.fire({ icon:'error', title:'Error', text: data?.message || 'Something went wrong!' });
            }
        } finally {
            btn.disabled = false; btn.textContent = 'Save Coupon';
        }
    });

    // ── Toggle status ─────────────────────────────────────────────────────────
    async function toggleCouponStatus(id) {
        try {
            const res = await axios.patch(`/admin/coupons/toggle/${id}`);
            if (res.data.success) {
                Swal.fire({ toast:true, position:'top-end', icon:'success', title: res.data.message, showConfirmButton:false, timer:2000 });
                setTimeout(() => window.location.reload(), 800);
            }
        } catch (err) {
            Swal.fire({ icon:'error', title:'Error', text: err.response?.data?.message || 'Failed to update status.' });
        }
    }

    // ── Delete coupon ─────────────────────────────────────────────────────────
    async function deleteCoupon(id) {
        const result = await Swal.fire({
            title:'Delete Coupon?',
            text:'This will soft-delete the coupon. Existing orders are unaffected.',
            icon:'warning', showCancelButton:true,
            confirmButtonColor:'#ef4444', cancelButtonColor:'#9ca3af',
            confirmButtonText:'Yes, delete it!'
        });
        if (!result.isConfirmed) return;
        try {
            const res = await axios.delete(`/admin/coupons/delete/${id}`);
            if (res.data.success) {
                await Swal.fire({ icon:'success', title:'Deleted!', text:'Coupon removed.', timer:1500, showConfirmButton:false });
                window.location.reload();
            }
        } catch (err) {
            Swal.fire({ icon:'error', title:'Error', text: err.response?.data?.message || 'Failed to delete coupon.' });
        }
    }
</script>


