<!-- Header -->
<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Offer Management</h2>
        <p class="text-sm text-gray-500 mt-1">Create and manage product & category discount offers</p>
    </div>
    <button onclick="openAddModal()"
        class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow-lg shadow-indigo-200 transition-all active:scale-95 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Offer
    </button>
</div>

<!-- Filters -->
<div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-6 flex flex-col md:flex-row gap-4">
    <form action="/admin/offers" method="GET" class="flex flex-1 flex-wrap gap-3" id="filterForm">
        <div class="relative flex-1 min-w-[200px]">
            <input type="text" name="search" value="<%= search %>" placeholder="Search offer name..."
                class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-semibold outline-none text-slate-700 placeholder-gray-400">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </div>
        </div>
        <select name="offerType" onchange="this.form.submit()"
            class="bg-gray-50 border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 block p-2.5 font-bold outline-none cursor-pointer">
            <option value="">All Types</option>
            <option value="product" <%= offerType === 'product' ? 'selected' : '' %>>Product Offers</option>
            <option value="category" <%= offerType === 'category' ? 'selected' : '' %>>Category Offers</option>
        </select>
        <select name="status" onchange="this.form.submit()"
            class="bg-gray-50 border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 block p-2.5 font-bold outline-none cursor-pointer">
            <option value="">All Statuses</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired</option>
        </select>
        <% if(search || offerType || status) { %>
            <a href="/admin/offers" class="px-4 py-2.5 text-sm font-bold text-gray-500 bg-gray-100 hover:bg-gray-200 rounded-xl transition">Clear</a>
        <% } %>
    </form>
</div>

<!-- Offers Table -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-600 whitespace-nowrap">
            <thead class="text-xs uppercase bg-gray-50 text-gray-400 font-black tracking-wider border-b border-gray-100">
                <tr>
                    <th class="px-6 py-4">Offer Name</th>
                    <th class="px-6 py-4">Type</th>
                    <th class="px-6 py-4">Discount</th>
                    <th class="px-6 py-4">Applied To</th>
                    <th class="px-6 py-4">Expiry</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if(offers.length > 0) { %>
                    <% offers.forEach(offer => { %>
                        <tr class="hover:bg-indigo-50/30 transition-colors group" id="offer-row-<%= offer._id %>">
                            <td class="px-6 py-4">
                                <p class="font-black text-slate-800"><%= offer.name %></p>
                                <% if(offer.description) { %>
                                    <p class="text-xs text-gray-400 mt-0.5 truncate max-w-[200px]" title="<%= offer.description %>"><%= offer.description %></p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-black uppercase tracking-wider
                                    <%= offer.offerType === 'product' ? 'bg-violet-100 text-violet-700' : 'bg-sky-100 text-sky-700' %>">
                                    <%= offer.offerType %>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-black text-indigo-600 text-sm">
                                    <%= offer.discountType === 'percentage' ? offer.discountValue + '%' : '₹' + offer.discountValue %>
                                </span>
                                <p class="text-[10px] text-gray-400 font-bold uppercase mt-0.5"><%= offer.discountType %></p>
                            </td>
                            <td class="px-6 py-4">
                                <p class="font-bold text-slate-700 text-sm truncate max-w-[180px]"><%= offer.targetName %></p>
                            </td>
                            <td class="px-6 py-4">
                                <p class="font-bold text-gray-700 text-sm"><%= new Date(offer.expiryDate).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></p>
                            </td>
                            <td class="px-6 py-4">
                                <% const statusMap = { Active: 'bg-green-100 text-green-700', Inactive: 'bg-gray-100 text-gray-500', Expired: 'bg-red-100 text-red-600' }; %>
                                <span class="px-2.5 py-1 rounded-lg text-[11px] font-black uppercase tracking-wider <%= statusMap[offer.dynamicStatus] %>">
                                    <%= offer.dynamicStatus %>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button onclick="openEditModal(JSON.parse(decodeURIComponent('<%= encodeURIComponent(JSON.stringify(offer)) %>')))"
                                        class="p-2 rounded-xl bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button onclick="toggleOffer('<%= offer._id %>', this)"
                                        class="p-2 rounded-xl transition <%= offer.isActive ? 'bg-yellow-50 text-yellow-600 hover:bg-yellow-100' : 'bg-green-50 text-green-600 hover:bg-green-100' %>"
                                        title="<%= offer.isActive ? 'Deactivate' : 'Activate' %>">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                                    </button>
                                    <button onclick="deleteOffer('<%= offer._id %>')"
                                        class="p-2 rounded-xl bg-red-50 text-red-500 hover:bg-red-100 transition" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="px-6 py-16 text-center">
                            <p class="text-gray-400 font-bold">No offers found.</p>
                            <p class="text-xs text-gray-400 mt-1">Create your first offer using the button above.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if(totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
            <p class="text-xs font-bold text-gray-400">Page <%= currentPage %> of <%= totalPages %></p>
            <nav class="flex items-center gap-1">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %><%= search ? '&search='+search : '' %><%= offerType ? '&offerType='+offerType : '' %><%= status ? '&status='+status : '' %>"
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold transition-colors
                        <%= currentPage === i ? 'bg-indigo-600 text-white shadow-sm' : 'text-gray-500 hover:bg-gray-100' %>">
                        <%= i %>
                    </a>
                <% } %>
            </nav>
        </div>
    <% } %>
</div>

<!-- Add/Edit Modal -->
<div id="offerModal" class="fixed inset-0 z-50 hidden bg-gray-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto" id="offerModalContent">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 rounded-t-2xl sticky top-0 z-10">
            <h3 id="modalTitle" class="text-lg font-black text-slate-800">Add New Offer</h3>
            <button onclick="closeModal()" class="text-gray-400 hover:text-red-500 transition p-1 rounded-lg hover:bg-red-50">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="offerForm" class="p-6 space-y-4">
            <input type="hidden" id="offerId">

            <!-- Offer Name -->
            <div>
                <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Offer Name <span class="text-red-500">*</span></label>
                <input type="text" id="offerName" placeholder="e.g. Summer Flash Sale" maxlength="100"
                    class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                <p id="offerNameError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <!-- Description -->
            <div>
                <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Description</label>
                <input type="text" id="offerDesc" placeholder="Short description (optional)" maxlength="200"
                    class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-semibold transition-all">
            </div>

            <!-- Offer Type -->
            <div>
                <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Offer Type <span class="text-red-500">*</span></label>
                <select id="offerType" onchange="handleTypeChange()"
                    class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                    <option value="product">Product Offer</option>
                    <option value="category">Category Offer</option>
                </select>
            </div>

            <!-- Searchable Product Selector -->
            <div id="productSelectorWrap">
                <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Select Product <span class="text-red-500">*</span></label>
                <div class="relative" id="productComboWrap">
                    <input type="text" id="productSearch" placeholder="Type to search products..."
                        autocomplete="off"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all"
                        oninput="filterOptions('product')" onfocus="openDropdown('product')" onblur="scheduleClose('product')">
                    <div id="productDropdown"
                        class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-48 overflow-y-auto text-sm">
                        <% products.forEach(p => { %>
                            <div class="product-option px-4 py-2.5 hover:bg-indigo-50 cursor-pointer font-bold text-gray-800 transition-colors"
                                data-id="<%= p._id %>" data-name="<%= p.name %>"
                                onmousedown="selectOption('product', this.dataset.id, this.dataset.name)">
                                <%= p.name %>
                            </div>
                        <% }) %>
                    </div>
                    <input type="hidden" id="productSelector">
                </div>
                <p id="applicableToError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <!-- Searchable Category Selector -->
            <div id="categorySelectorWrap" class="hidden">
                <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Select Category <span class="text-red-500">*</span></label>
                <div class="relative" id="categoryComboWrap">
                    <input type="text" id="categorySearch" placeholder="Type to search categories..."
                        autocomplete="off"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all"
                        oninput="filterOptions('category')" onfocus="openDropdown('category')" onblur="scheduleClose('category')">
                    <div id="categoryDropdown"
                        class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-48 overflow-y-auto text-sm">
                        <% categories.forEach(c => { %>
                            <div class="category-option px-4 py-2.5 hover:bg-indigo-50 cursor-pointer font-bold text-gray-800 transition-colors"
                                data-id="<%= c._id %>" data-name="<%= c.name %>"
                                onmousedown="selectOption('category', this.dataset.id, this.dataset.name)">
                                <%= c.name %>
                            </div>
                        <% }) %>
                    </div>
                    <input type="hidden" id="categorySelector">
                </div>
            </div>

            <!-- Discount Type + Value -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Discount Type <span class="text-red-500">*</span></label>
                    <select id="discountType"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                        <option value="flat">Flat (₹)</option>
                        <option value="percentage">Percentage (%)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Discount Value <span class="text-red-500">*</span></label>
                    <input type="number" id="discountValue" min="1" step="1" placeholder="e.g. 500"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="discountValueError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
            </div>

            <!-- Start + Expiry Date -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Start Date <span class="text-red-500">*</span></label>
                    <input type="date" id="startDate"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                    <p id="startDateError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-1.5">Expiry Date <span class="text-red-500">*</span></label>
                    <input type="date" id="expiryDate"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                    <p id="expiryDateError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
            </div>

            <!-- Active Status Toggle -->
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200">
                <div>
                    <p class="text-sm font-black text-gray-800">Active Status</p>
                    <p class="text-[11px] text-gray-400 font-semibold mt-0.5">Inactive offers will not apply to any products</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="offerIsActive" class="sr-only peer" checked>
                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
            </div>

            <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl text-sm font-bold text-gray-500 bg-gray-100 hover:bg-gray-200 transition">Cancel</button>
                <button type="button" id="submitBtn" onclick="submitOffer()" class="px-6 py-2.5 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 transition shadow-lg shadow-indigo-100">Save Offer</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // ── Searchable Combobox ───────────────────────────────────────────────────
    let closeTimers = {};
    function openDropdown(type)   { document.getElementById(`${type}Dropdown`).classList.remove('hidden'); }
    function scheduleClose(type)  { closeTimers[type] = setTimeout(() => document.getElementById(`${type}Dropdown`).classList.add('hidden'), 200); }
    function cancelClose(type)    { clearTimeout(closeTimers[type]); }

    function filterOptions(type) {
        const q = document.getElementById(`${type}Search`).value.toLowerCase();
        const dd = document.getElementById(`${type}Dropdown`);
        dd.classList.remove('hidden');
        dd.querySelectorAll(`.${type}-option`).forEach(o => o.classList.toggle('hidden', !o.dataset.name.toLowerCase().includes(q)));
    }

    function selectOption(type, id, name) {
        document.getElementById(`${type}Search`).value = name;
        document.getElementById(`${type}Selector`).value = id;
        document.getElementById(`${type}Dropdown`).classList.add('hidden');
        OfferV._clear('applicableTo', 'applicableToError');
    }

    // ── Validation helper ─────────────────────────────────────────────────────
    const OfferV = {
        _show(fieldId, errorId, msg) {
            const f = document.getElementById(fieldId);
            const e = document.getElementById(errorId);
            if (f) { f.classList.add('border-red-500'); f.classList.remove('border-gray-200'); }
            if (e) { e.textContent = msg; e.classList.remove('hidden'); }
        },
        _clear(fieldId, errorId) {
            const f = document.getElementById(fieldId);
            const e = document.getElementById(errorId);
            if (f) { f.classList.remove('border-red-500'); f.classList.add('border-gray-200'); }
            if (e) { e.textContent = ''; e.classList.add('hidden'); }
        },
        clearAll() {
            document.querySelectorAll('#offerForm .error-msg').forEach(e => { e.textContent = ''; e.classList.add('hidden'); });
            document.querySelectorAll('#offerForm input, #offerForm select').forEach(el => {
                el.classList.remove('border-red-500'); el.classList.add('border-gray-200');
            });
        },
        // Map backend Joi errors object → field-level UI
        applyBackendErrors(errors) {
            const fieldMap = {
                name:          ['offerName',     'offerNameError'],
                discountValue: ['discountValue', 'discountValueError'],
                applicableTo:  ['productSearch', 'applicableToError'],
                expiryDate:    ['expiryDate',    'expiryDateError'],
                startDate:     ['startDate',     'startDateError'],
            };
            Object.entries(errors).forEach(([key, msg]) => {
                const ids = fieldMap[key];
                if (ids) this._show(ids[0], ids[1], msg);
            });
        },

        name() {
            const v = document.getElementById('offerName').value.trim();
            if (!v)          return this._show('offerName','offerNameError','Offer name is required.'), false;
            if (v.length<2)  return this._show('offerName','offerNameError','Must be at least 2 characters.'), false;
            if (/^\d+$/.test(v)) return this._show('offerName','offerNameError','Offer name cannot be only numbers.'), false;
            if (v.length>100) return this._show('offerName','offerNameError','Cannot exceed 100 characters.'), false;
            this._clear('offerName','offerNameError'); return true;
        },
        applicableTo() {
            const type = document.getElementById('offerType').value;
            const val  = document.getElementById(`${type}Selector`).value;
            if (!val) return this._show(type==='product'?'productSearch':'categorySearch','applicableToError',`Please select a ${type}.`), false;
            this._clear(type==='product'?'productSearch':'categorySearch','applicableToError'); return true;
        },
        discountValue() {
            const dType = document.getElementById('discountType').value;
            const v = parseFloat(document.getElementById('discountValue').value);
            if (!document.getElementById('discountValue').value || isNaN(v))
                return this._show('discountValue','discountValueError','Discount value is required.'), false;
            if (v < 1) return this._show('discountValue','discountValueError','Must be at least 1.'), false;
            if (dType === 'percentage' && v > 90) return this._show('discountValue','discountValueError','Percentage cannot exceed 90%.'), false;
            this._clear('discountValue','discountValueError'); return true;
        },
        dates() {
            const start  = document.getElementById('startDate').value;
            const expiry = document.getElementById('expiryDate').value;
            const today  = new Date();
            today.setHours(0,0,0,0);

            let ok = true;
            if (!expiry) { 
                this._show('expiryDate','expiryDateError','Expiry date is required.'); ok = false; 
            } else if (new Date(expiry) < today) { 
                this._show('expiryDate','expiryDateError','Expiry date cannot be in the past.'); ok = false; 
            } else { 
                this._clear('expiryDate','expiryDateError'); 
            }

            if (!start) {
                this._show('startDate','startDateError','Start date is required.'); ok = false;
            } else if (new Date(start) < today) {
                this._show('startDate','startDateError','Start date cannot be in the past.'); ok = false;
            } else if (start && expiry && new Date(start) > new Date(expiry)) {
                this._show('startDate','startDateError','Start date must be on or before expiry date.'); ok = false;
            } else { 
                this._clear('startDate','startDateError'); 
            }
            return ok;
        },
        all() {
            return [this.name(), this.applicableTo(), this.discountValue(), this.dates()].every(Boolean);
        }
    };

    // ── Live validation ───────────────────────────────────────────────────────
    document.getElementById('offerName').addEventListener('input',    () => OfferV.name());
    document.getElementById('discountValue').addEventListener('input', () => OfferV.discountValue());
    document.getElementById('expiryDate').addEventListener('change',  () => OfferV.dates());
    document.getElementById('startDate').addEventListener('change',   () => OfferV.dates());
    document.getElementById('discountType').addEventListener('change', () => OfferV.discountValue());

    // ── Modal controls ────────────────────────────────────────────────────────
    const pad = n => n < 10 ? '0'+n : n;
    const toDateStr = d => { 
        const dt = new Date(d); 
        return `${dt.getFullYear()}-${pad(dt.getMonth()+1)}-${pad(dt.getDate())}`; 
    };

    function openAddModal() {
        document.getElementById('modalTitle').textContent = 'Add New Offer';
        document.getElementById('offerId').value = '';
        document.getElementById('offerForm').reset();
        document.getElementById('productSearch').value   = '';
        document.getElementById('productSelector').value = '';
        document.getElementById('categorySearch').value   = '';
        document.getElementById('categorySelector').value = '';
        document.getElementById('offerIsActive').checked = true;
        document.getElementById('startDate').value = toDateStr(new Date());
        document.getElementById('productSelectorWrap').classList.remove('hidden');
        document.getElementById('categorySelectorWrap').classList.add('hidden');
        OfferV.clearAll();
        document.getElementById('offerModal').classList.remove('hidden');
    }

    function openEditModal(offer) {
        document.getElementById('modalTitle').textContent = 'Edit Offer';
        document.getElementById('offerId').value   = offer._id;
        document.getElementById('offerName').value = offer.name;
        document.getElementById('offerDesc').value = offer.description || '';
        document.getElementById('offerType').value      = offer.offerType;
        document.getElementById('discountType').value   = offer.discountType;
        document.getElementById('discountValue').value  = offer.discountValue;
        document.getElementById('offerIsActive').checked = offer.isActive !== false;
        document.getElementById('expiryDate').value = toDateStr(offer.expiryDate);
        if (offer.startDate) document.getElementById('startDate').value = toDateStr(offer.startDate);
        handleTypeChange();
        if (offer.offerType === 'product') {
            document.getElementById('productSelector').value = offer.applicableTo;
            document.getElementById('productSearch').value   = offer.targetName || '';
        } else {
            document.getElementById('categorySelector').value = offer.applicableTo;
            document.getElementById('categorySearch').value   = offer.targetName || '';
        }
        OfferV.clearAll();
        document.getElementById('offerModal').classList.remove('hidden');
    }

    function closeModal() { document.getElementById('offerModal').classList.add('hidden'); }

    function handleTypeChange() {
        const type = document.getElementById('offerType').value;
        document.getElementById('productSelectorWrap').classList.toggle('hidden',  type !== 'product');
        document.getElementById('categorySelectorWrap').classList.toggle('hidden', type !== 'category');
    }

    // ── Submit ────────────────────────────────────────────────────────────────
    async function submitOffer() {
        OfferV.clearAll();
        if (!OfferV.all()) return;

        const id  = document.getElementById('offerId').value;
        const btn = document.getElementById('submitBtn');
        btn.disabled = true; btn.textContent = 'Saving…';

        const type = document.getElementById('offerType').value;
        const payload = {
            name:         document.getElementById('offerName').value.trim(),
            description:  document.getElementById('offerDesc').value.trim(),
            offerType:    type,
            discountType: document.getElementById('discountType').value,
            discountValue: parseFloat(document.getElementById('discountValue').value),
            applicableTo: document.getElementById(`${type}Selector`).value,
            startDate:    document.getElementById('startDate').value || null,
            expiryDate:   document.getElementById('expiryDate').value,
            isActive:     document.getElementById('offerIsActive').checked  // always explicit boolean
        };

        try {
            const url = id ? `/admin/offers/edit/${id}` : '/admin/offers/add';
            const res = await (id ? axios.patch(url, payload) : axios.post(url, payload));
            if (res.data.success) {
                await Swal.fire({ icon:'success', title:'Saved!', text: res.data.message, timer:1500, showConfirmButton:false });
                location.reload();
            }
        } catch (err) {
            const data = err.response?.data;
            if (data?.errors) {
                OfferV.applyBackendErrors(data.errors);
                Swal.fire({ icon:'warning', title:'Please fix the errors', text:'Check the highlighted fields.', timer:2500, showConfirmButton:false });
            } else {
                Swal.fire({ icon:'error', title:'Error', text: data?.message || 'Something went wrong.' });
            }
        } finally {
            btn.disabled = false; btn.textContent = 'Save Offer';
        }
    }

    // ── Toggle / Delete ───────────────────────────────────────────────────────
    async function toggleOffer(id) {
        try {
            const res = await axios.patch(`/admin/offers/toggle/${id}`);
            if (res.data.success) location.reload();
        } catch (err) {
            Swal.fire({ icon:'error', title:'Error', text: err.response?.data?.message || 'Failed.' });
        }
    }

    async function deleteOffer(id) {
        const confirm = await Swal.fire({
            icon:'warning', title:'Delete Offer?',
            text:'This will permanently remove the offer.',
            showCancelButton:true, confirmButtonText:'Yes, delete it',
            confirmButtonColor:'#ef4444'
        });
        if (!confirm.isConfirmed) return;
        try {
            const res = await axios.delete(`/admin/offers/delete/${id}`);
            if (res.data.success) document.getElementById(`offer-row-${id}`)?.remove();
        } catch (err) {
            Swal.fire({ icon:'error', title:'Error', text: err.response?.data?.message || 'Failed.' });
        }
    }

    // Close on backdrop click
    document.getElementById('offerModal').addEventListener('click', e => { if (e.target === document.getElementById('offerModal')) closeModal(); });
</script>

