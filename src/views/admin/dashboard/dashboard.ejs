<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<nav class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-6">
  Admin / <span class="text-indigo-600">Dashboard</span>
</nav>

<!-- Page Header -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-black text-slate-900 tracking-tight">
      Welcome back, <%= (typeof admin !== 'undefined' && admin && admin.fullName) ? admin.fullName.split(' ')[0] : 'Admin' %>! 👋
    </h1>
    <p class="text-gray-500 mt-1 font-medium">Financial Intelligence Dashboard</p>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <a href="/admin/sales-reports" class="bg-slate-900 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-md hover:bg-slate-800 transition-all flex items-center gap-2">
      <span>📈</span> Sales Reports
    </a>
    <select id="timeFilter" onchange="handleFilterChange()" class="bg-white border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block px-4 py-2.5 font-bold shadow-sm">
      <option value="Daily">Daily</option>
      <option value="Weekly">Weekly</option>
      <option value="Monthly" selected>Monthly</option>
      <option value="Yearly">Yearly</option>
      <option value="Custom">Custom Range</option>
    </select>
    <div id="customDateContainer" class="hidden flex-col sm:flex-row items-center gap-2">
      <input type="date" id="customFrom" max="<%= new Date().toISOString().split('T')[0] %>" class="bg-white border border-gray-200 text-slate-700 text-sm rounded-xl px-3 py-2 font-bold shadow-sm">
      <span class="text-gray-400 font-bold text-sm">to</span>
      <input type="date" id="customTo" max="<%= new Date().toISOString().split('T')[0] %>" class="bg-white border border-gray-200 text-slate-700 text-sm rounded-xl px-3 py-2 font-bold shadow-sm">
      <button onclick="fetchDashboardData()" class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm font-bold shadow hover:bg-indigo-700 transition">Apply</button>
    </div>
  </div>
</div>

<!-- ROW 1: Primary Financial KPIs -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">
  <!-- Gross Revenue -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
    <div class="w-11 h-11 bg-slate-100 rounded-2xl flex items-center justify-center text-lg mb-4">📦</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Gross Revenue</p>
    <h3 id="valGrossRevenue" class="text-2xl font-black text-slate-800">₹0</h3>
    <p id="growthGross" class="text-[10px] font-bold mt-2 text-gray-400">vs last period</p>
  </div>
  <!-- Net Revenue (Primary) -->
  <div class="bg-gradient-to-br from-indigo-600 to-violet-600 p-6 rounded-3xl shadow-lg shadow-indigo-100 hover:shadow-xl transition-all">
    <div class="w-11 h-11 bg-white/20 rounded-2xl flex items-center justify-center text-lg mb-4">💰</div>
    <p class="text-xs font-black text-indigo-200 uppercase tracking-widest mb-1">Net Revenue</p>
    <h3 id="valNetRevenue" class="text-2xl font-black text-white">₹0</h3>
    <p id="growthNet" class="text-[10px] font-bold mt-2 text-indigo-200">vs last period</p>
  </div>
  <!-- Refunds Issued -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
    <div class="w-11 h-11 bg-rose-50 rounded-2xl flex items-center justify-center text-lg mb-4">↩️</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Refunds Issued</p>
    <h3 id="valRefunds" class="text-2xl font-black text-rose-600">₹0</h3>
    <p id="valPendingLiability" class="text-[10px] font-bold mt-2 text-amber-500"></p>
  </div>
  <!-- Total Orders -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
    <div class="w-11 h-11 bg-blue-50 rounded-2xl flex items-center justify-center text-lg mb-4">🛒</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Total Orders</p>
    <h3 id="valTotalOrders" class="text-2xl font-black text-slate-800">0</h3>
    <p id="growthOrders" class="text-[10px] font-bold mt-2 text-gray-400">vs last period</p>
  </div>
</div>

<!-- ROW 2: Operational KPIs -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Avg Order Value</p>
    <h3 id="valAvg" class="text-xl font-black text-slate-800">₹0</h3>
  </div>
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Return Rate</p>
    <h3 id="valReturnRate" class="text-xl font-black text-amber-600">0%</h3>
  </div>
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Cancellation Rate</p>
    <h3 id="valCancelRate" class="text-xl font-black text-rose-600">0%</h3>
  </div>
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">New Customers</p>
    <h3 id="valCustomers" class="text-xl font-black text-slate-800">0</h3>
  </div>
</div>

<!-- ROW 3: Charts -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
  <!-- Revenue Trend (3 lines: Gross / Net / Refunded) -->
  <div class="lg:col-span-2 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h2 class="text-lg font-black text-slate-800">Revenue Trend</h2>
        <p class="text-xs text-gray-400 mt-0.5">Gross · Net · Refunds</p>
      </div>
    </div>
    <div class="relative h-72 w-full">
      <canvas id="revenueTrendChart"></canvas>
    </div>
  </div>

  <!-- Order Funnel -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6">Order Lifecycle</h2>
    <div id="funnelContainer" class="space-y-3"></div>
  </div>
</div>

<!-- ROW 4: Inventory + Recent Orders + Pending Returns -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
  <!-- Inventory Alerts -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2"><span class="text-xl">⚠️</span> Inventory</h2>
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between bg-red-50 p-4 rounded-2xl border border-red-100">
        <div>
          <p class="text-sm font-bold text-red-800">Out of Stock</p>
          <p class="text-xs text-red-600 mt-0.5">Variants at 0 qty</p>
        </div>
        <span class="text-xl font-black text-red-600"><%= inventoryAlerts.outOfStock %></span>
      </div>
      <div class="flex items-center justify-between bg-amber-50 p-4 rounded-2xl border border-amber-100">
        <div>
          <p class="text-sm font-bold text-amber-800">Low Stock</p>
          <p class="text-xs text-amber-600 mt-0.5">Variants ≤ 10 units</p>
        </div>
        <span class="text-xl font-black text-amber-600"><%= inventoryAlerts.lowStock %></span>
      </div>
    </div>
    <!-- Pending return liability (populated by JS) -->
    <div id="liabilityBlock" class="mt-4 hidden bg-violet-50 p-4 rounded-2xl border border-violet-100">
      <p class="text-sm font-bold text-violet-800">Pending Return Liability</p>
      <p id="valLiabilityDetail" class="text-xs text-violet-600 mt-0.5"></p>
    </div>
  </div>

  <!-- Recent Orders -->
  <div class="lg:col-span-2 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-black text-slate-800">Recent Orders</h2>
      <a href="/admin/orders" class="text-xs font-bold text-indigo-600 hover:underline">View All</a>
    </div>
    <div id="recentOrdersContainer" class="space-y-3"></div>
  </div>
</div>

<!-- ROW 5: Top Selling Lists -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">🏆</span> Top 10 Products</h2>
    <div id="topProductsContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2"></div>
  </div>
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">📁</span> Top 10 Categories</h2>
    <div id="topCategoriesContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2"></div>
  </div>
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">📑</span> Top 10 Subcategories</h2>
    <div id="topSubcategoriesContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2"></div>
  </div>
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">🏢</span> Top 10 Brands</h2>
    <div id="topBrandsContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2"></div>
  </div>
</div>

<script>
  let trendChartInstance = null;

  document.addEventListener('DOMContentLoaded', () => {
    fetchDashboardData();
    const customFrom = document.getElementById('customFrom');
    const customTo = document.getElementById('customTo');
    if (customFrom && customTo) {
      customFrom.addEventListener('change', (e) => {
        customTo.min = e.target.value;
        if (customTo.value && customTo.value < e.target.value) {
          customTo.value = '';
        }
      });
      if (customFrom.value) {
        customTo.min = customFrom.value;
      }
    }
  });

  function handleFilterChange() {
    const filter = document.getElementById('timeFilter').value;
    const cc = document.getElementById('customDateContainer');
    if (filter === 'Custom') {
      cc.classList.remove('hidden'); cc.classList.add('flex');
    } else {
      cc.classList.add('hidden'); cc.classList.remove('flex');
      fetchDashboardData();
    }
  }

  async function fetchDashboardData() {
    const filter = document.getElementById('timeFilter').value;
    let url = `/admin/dashboard/data?filter=${filter}`;
    if (filter === 'Custom') {
      const from = document.getElementById('customFrom').value;
      const to   = document.getElementById('customTo').value;
      if (!from || !to) return;
      url += `&customFrom=${from}&customTo=${to}`;
    }
    try {
      const res = await axios.get(url);
      if (res.data.success) updateDashboardUI(res.data.data);
    } catch (e) {
      console.error('Dashboard fetch failed', e);
      Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'Failed to load analytics', showConfirmButton: false, timer: 3000 });
    }
  }

  function fmt(n) { return `₹${Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 })}`; }
  function pct(n) { return `${Number(n || 0).toFixed(1)}%`; }

  function growthBadge(elementId, value) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const pos = Number(value) >= 0;
    el.className = `text-[10px] font-bold mt-2 ${pos ? 'text-emerald-500' : 'text-rose-500'}`;
    el.innerHTML = `<span>${pos ? '↑' : '↓'} ${Math.abs(value).toFixed(1)}%</span> <span class="text-gray-400">vs last period</span>`;
  }

  function updateDashboardUI(data) {
    const { kpis, trend, funnel, topProducts, topCategories, topSubcategories, topBrands, recentOrders } = data;

    // ── ROW 1 KPIs ──────────────────────────────────────────────────────────
    document.getElementById('valGrossRevenue').innerText = fmt(kpis.revenue.gross);
    document.getElementById('valNetRevenue').innerText   = fmt(kpis.revenue.net);
    document.getElementById('valRefunds').innerText      = fmt(kpis.revenue.totalRefunded);
    document.getElementById('valTotalOrders').innerText  = kpis.orders.total.toLocaleString();

    growthBadge('growthGross', kpis.growth.grossRevenue);
    growthBadge('growthNet',   kpis.growth.netRevenue);
    growthBadge('growthOrders', kpis.growth.orders);

    // Pending liability under refunds card
    if (kpis.liability.pendingRefundAmount > 0) {
      document.getElementById('valPendingLiability').innerText =
        `⚠ ${kpis.liability.pendingReturnItems} pending · ${fmt(kpis.liability.pendingRefundAmount)} at risk`;
    }

    // ── ROW 2 KPIs ──────────────────────────────────────────────────────────
    document.getElementById('valAvg').innerText        = fmt(kpis.orders.avgOrderValue);
    document.getElementById('valReturnRate').innerText = pct(kpis.orders.returnRate);
    document.getElementById('valCancelRate').innerText = pct(kpis.orders.cancellationRate);
    document.getElementById('valCustomers').innerText  = kpis.customers.newThisPeriod.toLocaleString();

    // Liability block
    if (kpis.liability.pendingRefundAmount > 0) {
      document.getElementById('liabilityBlock').classList.remove('hidden');
      document.getElementById('valLiabilityDetail').innerText =
        `${kpis.liability.pendingReturnItems} items · ${fmt(kpis.liability.pendingRefundAmount)} unprocessed`;
    }

    // ── Revenue Trend Chart ──────────────────────────────────────────────────
    renderTrendChart(trend);

    // ── Order Funnel ─────────────────────────────────────────────────────────
    renderFunnel(funnel);

    // ── Recent Orders ────────────────────────────────────────────────────────
    renderRecentOrders(recentOrders);

    // ── Top Lists ────────────────────────────────────────────────────────────
    renderTopList('topProductsContainer',      topProducts,      true);
    renderTopList('topCategoriesContainer',    topCategories,    false);
    renderTopList('topSubcategoriesContainer', topSubcategories, false);
    renderTopList('topBrandsContainer',        topBrands,        false);
  }

  function renderTrendChart(trend) {
    const ctx = document.getElementById('revenueTrendChart').getContext('2d');
    if (trendChartInstance) trendChartInstance.destroy();

    const gradient = ctx.createLinearGradient(0, 0, 0, 320);
    gradient.addColorStop(0, 'rgba(79,70,229,0.25)');
    gradient.addColorStop(1, 'rgba(79,70,229,0)');

    trendChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: trend.labels,
        datasets: [
          {
            label: 'Gross Revenue',
            data: trend.gross,
            borderColor: '#94a3b8',
            borderWidth: 2,
            borderDash: [4, 3],
            tension: 0.4,
            fill: false,
            pointRadius: 3,
            yAxisID: 'y'
          },
          {
            label: 'Net Revenue',
            data: trend.net,
            borderColor: '#4f46e5',
            backgroundColor: gradient,
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointRadius: 4,
            yAxisID: 'y'
          },
          {
            label: 'Refunds',
            data: trend.refunded,
            borderColor: '#f43f5e',
            borderWidth: 2,
            tension: 0.4,
            fill: false,
            pointRadius: 3,
            yAxisID: 'y'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: { weight: 'bold' } } },
          tooltip: {
            backgroundColor: 'rgba(15,23,42,0.9)',
            titleFont: { size: 12 },
            bodyFont: { size: 12, weight: 'bold' },
            padding: 12,
            cornerRadius: 8,
            callbacks: { label: ctx => ` ${ctx.dataset.label}: ₹${Number(ctx.raw).toLocaleString('en-IN')}` }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: { font: { weight: '600' } } },
          y: {
            type: 'linear', position: 'left',
            grid: { borderDash: [4,4], color: '#f3f4f6' },
            ticks: { callback: v => `₹${(v/1000).toFixed(0)}k` }
          }
        }
      }
    });
  }

  function renderFunnel(f) {
    const steps = [
      { label: 'Placed',    value: f.placed,    color: 'bg-slate-400'  },
      { label: 'Paid',      value: f.paid,      color: 'bg-indigo-500' },
      { label: 'Delivered', value: f.delivered, color: 'bg-emerald-500' },
      { label: 'Returned',  value: f.returned,  color: 'bg-amber-500'  },
      { label: 'Cancelled', value: f.cancelled, color: 'bg-rose-500'   }
    ];
    const max = Math.max(f.placed, 1);
    const container = document.getElementById('funnelContainer');
    container.innerHTML = steps.map(s => `
      <div>
        <div class="flex justify-between items-center mb-1">
          <span class="text-sm font-bold text-slate-700">${s.label}</span>
          <span class="text-sm font-black text-slate-900">${s.value.toLocaleString()}</span>
        </div>
        <div class="h-2.5 bg-gray-100 rounded-full overflow-hidden">
          <div class="h-full ${s.color} rounded-full transition-all duration-500" style="width:${((s.value/max)*100).toFixed(1)}%"></div>
        </div>
      </div>`).join('');
  }

  function renderRecentOrders(orders) {
    const container = document.getElementById('recentOrdersContainer');
    if (!orders || orders.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-500">No recent orders.</p>';
      return;
    }
    container.innerHTML = orders.map(o => {
      const net = o.activeTotal ?? o.totalAmount;
      const statusColors = {
        'Delivered': 'text-emerald-600 bg-emerald-50',
        'Cancelled': 'text-rose-600 bg-rose-50',
        'Returned':  'text-amber-600 bg-amber-50'
      };
      const sc = statusColors[o.orderStatus] || 'text-indigo-600 bg-indigo-50';
      return `
        <div class="flex items-center justify-between border-b border-gray-50 pb-3 last:border-0 last:pb-0">
          <div>
            <p class="text-sm font-bold text-slate-800">#${o.orderId || o._id.toString().slice(-6)}</p>
            <p class="text-xs text-gray-500">${o.user?.fullName || 'Guest'}</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-black text-indigo-600">₹${Number(net).toLocaleString('en-IN', { maximumFractionDigits: 0 })}</p>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${sc}">${o.orderStatus}</span>
          </div>
        </div>`;
    }).join('');
  }

  function renderTopList(containerId, items, isProduct) {
    const container = document.getElementById(containerId);
    if (!items || items.length === 0) {
      container.innerHTML = `<p class="text-sm text-gray-500 text-center py-4">No data for this period.</p>`;
      return;
    }
    const maxQty = Math.max(...items.map(i => i.totalQuantity));
    container.innerHTML = items.map((item, idx) => {
      const pct = ((item.totalQuantity / maxQty) * 100).toFixed(1);
      const imgHtml = isProduct && item.image
        ? `<img src="${item.image}" class="w-11 h-11 rounded-xl object-cover border border-gray-100 flex-shrink-0">`
        : `<div class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-gray-400 font-black text-xs border border-gray-100 flex-shrink-0">#${idx+1}</div>`;
      return `
        <div class="flex items-center gap-4 group hover:bg-gray-50 p-2 rounded-2xl transition">
          ${imgHtml}
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-black text-slate-800 truncate">${item.name || 'Unknown'}</h4>
            <div class="flex items-center gap-3 mt-1.5">
              <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-indigo-500 rounded-full" style="width:${pct}%"></div>
              </div>
              <span class="text-xs font-bold text-gray-500 w-16 text-right">${item.totalQuantity} sold</span>
            </div>
          </div>
          <div class="text-right flex-shrink-0 hidden sm:block">
            <p class="text-sm font-black text-indigo-600">₹${Number(item.totalRevenue).toLocaleString('en-IN', { maximumFractionDigits: 0 })}</p>
            <p class="text-[10px] text-gray-400 font-bold uppercase">Net</p>
          </div>
        </div>`;
    }).join('');
  }
</script>