<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<nav class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-6">
  Admin / <span class="text-indigo-600">Dashboard</span>
</nav>

<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-black text-slate-900 tracking-tight">
      Welcome back, <%= (typeof admin !== 'undefined' && admin && admin.fullName) ? admin.fullName.split(' ')[0] : 'Admin' %>! 👋
    </h1>
    <p class="text-gray-500 mt-2 font-medium">Here's your store's performance at a glance.</p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <a href="/admin/sales-reports" class="bg-slate-900 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-md hover:bg-slate-800 transition-all flex items-center gap-2">
      <span>📈</span> View Sales Reports
    </a>
    <!-- Filter Dropdown -->
    <select id="timeFilter" onchange="handleFilterChange()" class="bg-white border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:w-auto px-4 py-2.5 font-bold shadow-sm">
      <option value="Daily">Daily</option>
      <option value="Weekly">Weekly</option>
      <option value="Monthly" selected>Monthly</option>
      <option value="Yearly">Yearly</option>
      <option value="Custom">Custom Range</option>
    </select>

    <!-- Custom Date Pickers (Hidden by default) -->
    <div id="customDateContainer" class="hidden flex-col sm:flex-row items-center gap-2">
      <input type="date" id="customFrom" class="bg-white border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block px-3 py-2 font-bold shadow-sm">
      <span class="text-gray-400 font-bold text-sm">to</span>
      <input type="date" id="customTo" class="bg-white border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block px-3 py-2 font-bold shadow-sm">
      <button onclick="fetchDashboardData()" class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm font-bold shadow hover:bg-indigo-700 transition">Apply</button>
    </div>
  </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
    <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-emerald-500">💰</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Total Revenue</p>
    <h3 id="valTotalRevenue" class="text-2xl font-black text-slate-800">₹0</h3>
    <p id="growthRevenue" class="text-[10px] font-bold mt-2"></p>
  </div>
  
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-blue-500">📦</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Total Orders</p>
    <h3 id="valTotalOrders" class="text-2xl font-black text-slate-800">0</h3>
    <p id="growthOrders" class="text-[10px] font-bold mt-2"></p>
  </div>

  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
    <div class="w-12 h-12 bg-purple-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-purple-500">👥</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Total Customers</p>
    <h3 id="valTotalCustomers" class="text-2xl font-black text-slate-800">0</h3>
  </div>

  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm transition-all hover:shadow-md">
    <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-xl mb-4 text-amber-500">📊</div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1">Avg Order Value</p>
    <h3 id="valAvgOrderValue" class="text-2xl font-black text-slate-800">₹0</h3>
  </div>

  <a href="/admin/sales-reports" class="sm:col-span-2 lg:col-span-4 bg-gradient-to-r from-indigo-600 to-violet-600 p-8 rounded-[2.5rem] shadow-xl shadow-indigo-100 flex items-center justify-between group overflow-hidden relative transition-all hover:scale-[1.01]">
    <div class="relative z-10">
      <h2 class="text-2xl font-black text-white mb-2">Advanced Sales Reports</h2>
      <p class="text-indigo-100 font-medium opacity-90">Deep dive into revenue analytics, coupon usage, and exportable reports.</p>
      <div class="mt-6 inline-flex items-center gap-2 bg-white text-indigo-600 px-6 py-3 rounded-2xl text-sm font-black shadow-lg group-hover:bg-indigo-50 transition-colors">
        Open Module <span class="group-hover:translate-x-1 transition-transform">→</span>
      </div>
    </div>
    <div class="text-7xl opacity-20 group-hover:scale-110 transition-transform relative z-10">📈</div>
    <!-- Decorative circles -->
    <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
    <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-black/10 rounded-full blur-2xl"></div>
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
  <!-- Sales Chart -->
  <div class="lg:col-span-2 bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-lg font-black text-slate-800">Sales Activity</h2>
    </div>
    <div class="relative h-80 w-full">
      <canvas id="salesChart"></canvas>
    </div>
  </div>

  <!-- Inventory & Recent Orders Sidebar -->
  <div class="space-y-8">
    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
      <h2 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2"><span class="text-xl">⚠️</span> Inventory Alerts</h2>
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between bg-red-50 p-4 rounded-2xl border border-red-100">
          <div>
            <p class="text-sm font-bold text-red-800">Out of Stock</p>
            <p class="text-xs text-red-600 mt-0.5">Products with 0 quantity</p>
          </div>
          <span class="text-xl font-black text-red-600"><%= inventoryAlerts.outOfStock %></span>
        </div>
        <div class="flex items-center justify-between bg-amber-50 p-4 rounded-2xl border border-amber-100">
          <div>
            <p class="text-sm font-bold text-amber-800">Low Stock</p>
            <p class="text-xs text-amber-600 mt-0.5">Items running low (≤10)</p>
          </div>
          <span class="text-xl font-black text-amber-600"><%= inventoryAlerts.lowStock %></span>
        </div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-black text-slate-800">Recent Orders</h2>
        <a href="/admin/orders" class="text-xs font-bold text-indigo-600 hover:underline">View All</a>
      </div>
      <div id="recentOrdersContainer" class="space-y-4">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>
</div>

<!-- Top Selling Sections (Grid) -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  <!-- Top Products -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">🏆</span> Top 10 Products</h2>
    <div id="topProductsContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
      <!-- Injected dynamically -->
    </div>
  </div>

  <!-- Top Categories -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">📁</span> Top 10 Categories</h2>
    <div id="topCategoriesContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
      <!-- Injected dynamically -->
    </div>
  </div>

  <!-- Top Subcategories -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">📑</span> Top 10 Subcategories</h2>
    <div id="topSubcategoriesContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
      <!-- Injected dynamically -->
    </div>
  </div>

  <!-- Top Brands -->
  <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm">
    <h2 class="text-lg font-black text-slate-800 mb-6 flex items-center gap-2"><span class="text-xl">🏢</span> Top 10 Brands</h2>
    <div id="topBrandsContainer" class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
      <!-- Injected dynamically -->
    </div>
  </div>
</div>

<script>
  let salesChartInstance = null;

  document.addEventListener('DOMContentLoaded', () => {
    fetchDashboardData();
  });

  function handleFilterChange() {
    const filter = document.getElementById('timeFilter').value;
    const customContainer = document.getElementById('customDateContainer');
    
    if (filter === 'Custom') {
      customContainer.classList.remove('hidden');
      customContainer.classList.add('flex');
    } else {
      customContainer.classList.add('hidden');
      customContainer.classList.remove('flex');
      fetchDashboardData();
    }
  }

  async function fetchDashboardData() {
    const filter = document.getElementById('timeFilter').value;
    let url = `/admin/dashboard/data?filter=${filter}`;

    if (filter === 'Custom') {
      const from = document.getElementById('customFrom').value;
      const to = document.getElementById('customTo').value;
      if (!from || !to) return; // Wait until both are selected
      url += `&customFrom=${from}&customTo=${to}`;
    }

    try {
      const response = await axios.get(url);
      if (response.data.success) {
        updateDashboardUI(response.data.data);
      }
    } catch (error) {
      console.error("Failed to fetch dashboard data:", error);
      Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'Failed to load analytics', showConfirmButton: false, timer: 3000 });
    }
  }

  function updateDashboardUI(data) {
    // 1. Update Summary Cards
    document.getElementById('valTotalRevenue').innerText = `₹${data.summary.totalRevenue.toLocaleString()}`;
    document.getElementById('valTotalOrders').innerText = data.summary.totalOrders.toLocaleString();
    document.getElementById('valTotalCustomers').innerText = data.summary.totalCustomers.toLocaleString();
    document.getElementById('valAvgOrderValue').innerText = `₹${Math.round(data.summary.averageOrderValue || 0).toLocaleString()}`;
    
    // Update Growth Indicators
    updateGrowthIndicator('growthRevenue', data.summary.revenueGrowth);
    updateGrowthIndicator('growthOrders', data.summary.orderGrowth);

    // 2. Update Chart
    updateChart(data.chart);

    // 3. Update Recent Orders
    renderRecentOrders(data.recentOrders);

    // 4. Update Top Lists
    renderTopList('topProductsContainer', data.topProducts, true);
    renderTopList('topCategoriesContainer', data.topCategories, false);
    renderTopList('topSubcategoriesContainer', data.topSubcategories, false);
    renderTopList('topBrandsContainer', data.topBrands, false);
  }

  function updateGrowthIndicator(elementId, growth) {
    const el = document.getElementById(elementId);
    const isPositive = growth >= 0;
    const colorClass = isPositive ? 'text-emerald-500' : 'text-rose-500';
    const arrow = isPositive ? '↑' : '↓';
    el.className = `text-[10px] font-bold mt-2 ${colorClass}`;
    el.innerHTML = `<span>${arrow} ${Math.abs(growth).toFixed(1)}%</span> <span class="text-gray-400">vs last period</span>`;
  }

  function renderRecentOrders(orders) {
    const container = document.getElementById('recentOrdersContainer');
    container.innerHTML = '';

    if (!orders || orders.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-500">No recent orders.</p>';
      return;
    }

    orders.forEach(order => {
      const customerName = order.user ? order.user.fullName : 'Guest';
      container.innerHTML += `
        <div class="flex items-center justify-between border-b border-gray-50 pb-3 last:border-0 last:pb-0">
          <div>
            <p class="text-sm font-bold text-slate-800">#${order.orderId || order._id.toString().slice(-6)}</p>
            <p class="text-xs text-gray-500">${customerName}</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-black text-indigo-600">₹${order.totalAmount.toLocaleString()}</p>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">${order.orderStatus}</p>
          </div>
        </div>
      `;
    });
  }

  function updateChart(chartData) {
    const ctx = document.getElementById('salesChart').getContext('2d');
    
    if (salesChartInstance) {
      salesChartInstance.destroy();
    }

    // Gradient for revenue line
    let gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(79, 70, 229, 0.5)'); // Indigo 600
    gradient.addColorStop(1, 'rgba(79, 70, 229, 0)');

    salesChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartData.labels,
        datasets: [
          {
            label: 'Revenue (₹)',
            data: chartData.revenue,
            borderColor: '#4F46E5', // Indigo 600
            backgroundColor: gradient,
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            yAxisID: 'y'
          },
          {
            label: 'Orders',
            data: chartData.orders,
            type: 'bar',
            backgroundColor: '#E0E7FF', // Indigo 100
            borderRadius: 6,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: {
            position: 'top',
            labels: { usePointStyle: true, boxWidth: 8, font: { weight: 'bold' } }
          },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.9)', // Slate 900
            titleFont: { size: 13 },
            bodyFont: { size: 13, weight: 'bold' },
            padding: 12,
            cornerRadius: 8,
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { weight: '600' } }
          },
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            grid: { borderDash: [4, 4], color: '#F3F4F6' },
            title: { display: true, text: 'Revenue (₹)', font: { weight: 'bold' } }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            grid: { display: false },
            title: { display: true, text: 'Orders', font: { weight: 'bold' } }
          }
        }
      }
    });
  }

  function renderTopList(containerId, items, isProduct) {
    const container = document.getElementById(containerId);
    container.innerHTML = '';

    if (!items || items.length === 0) {
      container.innerHTML = `<p class="text-sm text-gray-500 text-center py-4">No data available for this period.</p>`;
      return;
    }

    // Find max value to calculate percentage bars
    const maxQty = Math.max(...items.map(item => item.totalQuantity));

    items.forEach((item, index) => {
      const percentage = (item.totalQuantity / maxQty) * 100;
      
      let imageHtml = '';
      if (isProduct) {
        const imgSrc = item.image ? item.image : 'https://placehold.co/100x100?text=No+Image';
        imageHtml = `<img src="${imgSrc}" class="w-12 h-12 rounded-xl object-cover border border-gray-100 flex-shrink-0">`;
      } else {
        // Fallback icon/badge for categories/brands
        imageHtml = `<div class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-gray-400 font-black text-xs border border-gray-100 flex-shrink-0">#${index+1}</div>`;
      }

      const html = `
        <div class="flex items-center gap-4 group hover:bg-gray-50 p-2 rounded-2xl transition">
          ${imageHtml}
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-black text-slate-800 truncate">${item.name || 'Unknown'}</h4>
            <div class="flex items-center gap-3 mt-1.5">
              <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-indigo-500 rounded-full" style="width: ${percentage}%"></div>
              </div>
              <span class="text-xs font-bold text-gray-500 w-16 text-right">${item.totalQuantity} sold</span>
            </div>
          </div>
          <div class="text-right flex-shrink-0 hidden sm:block">
            <p class="text-sm font-black text-indigo-600">₹${item.totalRevenue.toLocaleString()}</p>
            <p class="text-[10px] text-gray-400 font-bold uppercase">Revenue</p>
          </div>
        </div>
      `;
      container.innerHTML += html;
    });
  }
</script>