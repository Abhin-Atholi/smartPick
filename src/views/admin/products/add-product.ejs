<!-- Cropper.js CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.1/dist/cropper.min.css">
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.1/dist/cropper.min.js"></script>

<div class="max-w-5xl mx-auto pb-20">

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h2 class="text-2xl font-black text-slate-800">Add New Product</h2>
            <p class="text-sm text-gray-400 font-bold mt-0.5">Follow the steps to add a new fashion item.</p>
        </div>
        <a href="/admin/products" class="px-5 py-2 rounded-xl text-sm font-black text-gray-500 bg-white border border-gray-200 hover:bg-gray-50 transition flex items-center gap-2">
            ← Back to Products
        </a>
    </div>

    <form id="addProductForm" class="space-y-6">

        <!-- STEP 1: Basic Details -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-5">
            <h3 class="text-sm font-black text-gray-400 uppercase tracking-widest border-b border-gray-100 pb-3">Step 1: Product Details</h3>
            
            <div>
                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Product Name *</label>
                <input type="text" id="productName" name="name" placeholder="e.g. Classic Polo Shirt"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-bold text-slate-700 text-sm">
                <p id="productNameError" class="error-text text-rose-500 text-xs font-bold mt-1 hidden"></p>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Brand</label>
                    <input type="text" id="productBrand" name="brand" placeholder="e.g. Nike"
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-bold text-slate-700 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Category *</label>
                    <select id="productCategory" name="category"
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-bold text-slate-700 text-sm cursor-pointer">
                        <option value="">Select category...</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat._id %>"><%= cat.name %></option>
                        <% }) %>
                    </select>
                    <p id="productCategoryError" class="error-text text-rose-500 text-xs font-bold mt-1 hidden"></p>
                </div>
            </div>

            <div>
                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Subcategory</label>
                <select id="productSubcategory" name="subcategory"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-4 focus:ring-indigo-100 outline-none transition-all font-bold text-slate-700 text-sm cursor-pointer">
                    <option value="">Select category first...</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Description</label>
                <textarea id="productDesc" name="description" rows="4" placeholder="Describe the product..."
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-4 focus:ring-indigo-100 outline-none transition-all text-sm font-medium text-slate-700 resize-none"></textarea>
            </div>
        </div>

        <!-- STEP 2 & 3: Colors and Images -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                <h3 class="text-sm font-black text-gray-400 uppercase tracking-widest">Step 2 & 3: Colors & Images</h3>
                <button type="button" onclick="addColorSection()" class="px-4 py-2 bg-indigo-50 text-indigo-600 font-black text-xs rounded-xl hover:bg-indigo-100 transition shadow-sm">+ Add Color</button>
            </div>
            
            <div id="colorsContainer" class="space-y-6">
                <!-- Color sections will be added here dynamically -->
            </div>
            <p id="colorError" class="text-rose-500 text-xs font-bold mt-2 hidden">At least one color with minimum 3 images is required.</p>
        </div>

        <!-- STEP 4: Variants -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                <h3 class="text-sm font-black text-gray-400 uppercase tracking-widest">Step 4: Product Variants</h3>
                <button type="button" onclick="addVariantRow()" class="px-4 py-2 bg-indigo-50 text-indigo-600 font-black text-xs rounded-xl hover:bg-indigo-100 transition shadow-sm">+ Add Variant</button>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left" id="variantsTable">
                    <thead>
                        <tr class="text-[10px] uppercase tracking-widest text-gray-400 font-black border-b border-gray-100">
                            <th class="pb-3 pr-3">Size</th>
                            <th class="pb-3 pr-3">Color</th>
                            <th class="pb-3 pr-3">Price (₹)</th>
                            <th class="pb-3 pr-3">Stock</th>
                            <th class="pb-3"></th>
                        </tr>
                    </thead>
                    <tbody id="variantsBody">
                        <!-- Variant rows injected via JS -->
                    </tbody>
                </table>
            </div>
            <p id="variantError" class="text-rose-500 text-xs font-bold mt-2 hidden">At least one variant is required.</p>
        </div>

        <!-- Settings Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4">
            <h3 class="text-sm font-black text-gray-400 uppercase tracking-widest">Settings</h3>
            
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-black text-slate-700">Active</p>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Visible in storefront</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="productActive" name="isActive" class="sr-only peer" checked>
                    <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                </label>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-gray-50">
                <div>
                    <p class="text-sm font-black text-slate-700">Featured ⭐</p>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Show on homepage</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="productFeatured" name="isFeatured" class="sr-only peer">
                    <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                </label>
            </div>
        </div>

        <!-- Submit Button -->
        <button type="button" onclick="submitProductForm()" id="submitProductBtn"
            class="w-full py-4 bg-indigo-600 text-white font-black rounded-2xl hover:bg-indigo-700 transition shadow-xl shadow-indigo-200 text-base uppercase tracking-widest">
            Create Product
        </button>
    </form>
</div>

<%- include("../partials/image-cropper") %>

<script>
    // ── Category → Subcategory AJAX ─────────────────────────────────────────
    document.getElementById('productCategory').addEventListener('change', async function () {
        const catId = this.value;
        const subSelect = document.getElementById('productSubcategory');
        subSelect.innerHTML = '<option value="">Loading...</option>';
        if (!catId) { subSelect.innerHTML = '<option value="">Select category first...</option>'; return; }
        try {
            const res = await axios.get(`/admin/products/subcategories/${catId}`);
            if (res.data.success && res.data.subcategories.length > 0) {
                subSelect.innerHTML = '<option value="">None (optional)</option>' +
                    res.data.subcategories.map(s => `<option value="${s._id}">${s.name}</option>`).join('');
            } else {
                subSelect.innerHTML = '<option value="">No subcategories available</option>';
            }
        } catch {
            subSelect.innerHTML = '<option value="">Error loading subcategories</option>';
        }
    });

    // ── Predefined Colors ─────────────────────────────────────────
    const PREDEFINED_COLORS = [
      { name: 'Black', code: '#000000' },
      { name: 'White', code: '#FFFFFF' },
      { name: 'Red', code: '#EF4444' },
      { name: 'Blue', code: '#3B82F6' },
      { name: 'Green', code: '#22C55E' },
      { name: 'Yellow', code: '#EAB308' },
      { name: 'Orange', code: '#F97316' },
      { name: 'Purple', code: '#A855F7' },
      { name: 'Grey', code: '#6B7280' },
      { name: 'Navy', code: '#1E3A8A' }
    ];

    // ── Colors Management ──────────────────────────────────────────────────
    let colorCount = 0;
    let colorBlobs = {}; // mapping colorId -> array of blobs
    let activeColorUploadId = null;

    function addColorSection() {
        const colorId = `color-section-${colorCount}`;
        colorBlobs[colorId] = [];
        
        const div = document.createElement('div');
        div.id = colorId;
        div.className = 'border border-gray-200 rounded-xl p-4 bg-gray-50/50';

        const colorOptions = PREDEFINED_COLORS.map(c => `
          <option value='${JSON.stringify(c)}'>
            ${c.name}
          </option>
        `).join('');

        div.innerHTML = `
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-4 flex-1">
                    <div class="w-1/3">
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Color Name</label>
                        <select class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-100 cursor-pointer" data-field="color-data" onchange="updateColorData('${colorId}', this)">
                            <option value="">Select Color...</option>
                            ${colorOptions}
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Preview</label>
                        <div class="w-9 h-9 rounded-lg border border-gray-200 color-preview bg-white shadow-sm flex items-center justify-center text-xs text-gray-300">?</div>
                    </div>
                    <div class="ml-4 flex items-center gap-2 mt-5">
                        <input type="radio" name="defaultColorRadio" value="\${colorId}" class="w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 cursor-pointer default-color-radio" \${colorCount === 0 ? 'checked' : ''}>
                        <label class="text-[10px] font-black text-gray-500 uppercase tracking-widest cursor-pointer" onclick="this.previousElementSibling.click()">Set Default</label>
                    </div>
                </div>
                <button type="button" onclick="removeColorSection('${colorId}')" class="text-gray-400 hover:text-rose-500 transition font-black text-xl leading-none">✕</button>
            </div>

            <!-- Image Upload Zone -->
            <div class="mt-4 bg-white border border-dashed border-gray-200 rounded-xl p-4">
                <div class="flex items-center justify-between mb-3">
                    <h4 class="text-xs font-black text-gray-600 uppercase tracking-widest">Color Images <span class="text-rose-500">*</span></h4>
                    <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md">Min 3</span>
                </div>
                
                <div class="flex gap-4">
                    <div class="w-32 h-32 border-2 border-dashed border-indigo-100 rounded-xl flex flex-col items-center justify-center hover:bg-indigo-50 hover:border-indigo-300 transition cursor-pointer flex-shrink-0" onclick="triggerColorUpload('${colorId}')">
                        <span class="text-2xl mb-1">📸</span>
                        <span class="text-[10px] font-black text-indigo-600 uppercase">Upload</span>
                    </div>
                    
                    <div id="grid-${colorId}" class="flex-1 grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-2 auto-rows-max">
                        <!-- Previews go here -->
                    </div>
                </div>
                <input type="file" id="file-${colorId}" accept="image/*" multiple class="hidden" onchange="handleColorFiles(event, '${colorId}')">
            </div>
        `;
        document.getElementById('colorsContainer').appendChild(div);
        colorCount++;
        updateVariantColorDropdowns();
    }

    function updateColorData(colorId, selectElem) {
        const preview = document.querySelector(`#${colorId} .color-preview`);
        try {
            const color = JSON.parse(selectElem.value);
            preview.style.backgroundColor = color.code;
            preview.innerHTML = '';
        } catch {
            preview.style.backgroundColor = '#FFFFFF';
            preview.innerHTML = '?';
        }
        updateVariantColorDropdowns();
    }

    function removeColorSection(colorId) {
        delete colorBlobs[colorId];
        document.getElementById(colorId)?.remove();
        updateVariantColorDropdowns();
    }

    // ── Variant Management ──────────────────────────────────────────────────
    let variantCount = 0;

    function addVariantRow(data = {}) {
        variantCount++;
        const rowId = `variant-row-${variantCount}`;

        const row = document.createElement('tr');
        row.id = rowId;
        row.className = 'border-b border-gray-50 hover:bg-gray-50 transition-colors';
        
        const sizeOptions = ["S", "M", "L", "XL", "XXL", "Free Size"].map(s => `<option value="${s}" ${data.size === s ? 'selected' : ''}>${s}</option>`).join('');
        
        row.innerHTML = `
            <td class="py-3 pr-3">
              <select class="w-full min-w-[80px] px-2 py-2 bg-gray-50 border border-gray-200 rounded-lg text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-100 cursor-pointer" data-field="size">
                ${sizeOptions}
              </select>
            </td>
            <td class="py-3 pr-3">
              <select class="w-full min-w-[120px] px-2 py-2 bg-gray-50 border border-gray-200 rounded-lg text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-100 cursor-pointer variant-color-select" data-field="color">
                <option value="">Select Color</option>
              </select>
            </td>
            <td class="py-3 pr-3">
              <input type="number" value="${data.price || ''}" placeholder="Price ₹" min="1" class="w-full min-w-[80px] px-2 py-2 bg-gray-50 border border-gray-200 rounded-lg text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-100" data-field="price">
            </td>
            <td class="py-3 pr-3">
              <input type="number" value="${data.stock || ''}" placeholder="Stock" min="0" class="w-full min-w-[80px] px-2 py-2 bg-gray-50 border border-gray-200 rounded-lg text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-100" data-field="stock">
            </td>
            <td class="py-3 text-right">
                <button type="button" onclick="document.getElementById('${rowId}').remove()" class="text-gray-300 hover:text-rose-500 transition font-black text-lg leading-none px-2">✕</button>
            </td>
        `;
        document.getElementById('variantsBody').appendChild(row);
        updateVariantColorDropdowns();
    }

    function getAddedColors() {
        const colors = [];
        const sections = document.querySelectorAll('#colorsContainer > div');
        sections.forEach(sec => {
            const select = sec.querySelector('[data-field="color-data"]');
            if (select && select.value) {
                try {
                    const parsed = JSON.parse(select.value);
                    if (!colors.find(c => c.name === parsed.name)) {
                        colors.push(parsed);
                    }
                } catch(e) {}
            }
        });
        return colors;
    }

    function updateVariantColorDropdowns() {
        const addedColors = getAddedColors();
        const selects = document.querySelectorAll('.variant-color-select');
        
        selects.forEach(select => {
            const currentValue = select.value;
            select.innerHTML = '<option value="">Select Color</option>' + 
                addedColors.map(c => `<option value="${c.name}" ${currentValue === c.name ? 'selected' : ''}>${c.name}</option>`).join('');
        });
    }

    // ── Cropper Integration ─────────────────────────────────────────────────────
    let pendingFiles = [];
    let pendingIndex = 0;

    function triggerColorUpload(colorId) {
        activeColorUploadId = colorId;
        document.getElementById(`file-${colorId}`).click();
    }

    function handleColorFiles(e, colorId) {
        const files = Array.from(e.target.files);
        const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/jpg'];
        
        let validFiles = [];
        for (const file of files) {
            if (!validTypes.includes(file.type)) continue;
            if (file.size > 2 * 1024 * 1024) {
                Swal.fire('File Too Large', `Image "${file.name}" exceeds the 2MB limit.`, 'warning');
                continue;
            }
            validFiles.push(file);
        }

        pendingFiles = validFiles;
        pendingIndex = 0;
        e.target.value = ''; 
        if (pendingFiles.length > 0) processNextPendingFile();
    }

    async function processNextPendingFile() {
        if (pendingIndex >= pendingFiles.length) return;
        const file = pendingFiles[pendingIndex];
        pendingIndex++;
        
        try {
            const croppedFile = await cropImage(file); 
            if (activeColorUploadId && colorBlobs[activeColorUploadId]) {
                colorBlobs[activeColorUploadId].push(croppedFile);
                redrawColorImages(activeColorUploadId);
            }
        } catch (err) {
            console.log('Skipped cropping for', file.name);
        }
        
        processNextPendingFile(); 
    }

    function redrawColorImages(colorId) {
        const grid = document.getElementById(`grid-${colorId}`);
        if (!grid || !colorBlobs[colorId]) return;
        
        grid.innerHTML = '';
        const blobs = colorBlobs[colorId];
        
        blobs.forEach((blob, index) => {
            const src = URL.createObjectURL(blob);
            const div = document.createElement('div');
            div.className = 'relative w-32 h-32 rounded-xl overflow-hidden border border-gray-200 shadow-sm group flex-shrink-0';
            div.innerHTML = `
                <img src="${src}" class="w-full h-full object-cover">
                <button type="button" onclick="removeColorImage('${colorId}', ${index})"
                    class="absolute top-1 right-1 w-6 h-6 bg-rose-500 text-white rounded-full text-xs font-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition">✕</button>
            `;
            grid.appendChild(div);
        });
    }

    function removeColorImage(colorId, index) {
        if (colorBlobs[colorId]) {
            colorBlobs[colorId].splice(index, 1);
            redrawColorImages(colorId);
        }
    }

    // ── Form Submit ──────────────────────────────────────────────────────────
    async function submitProductForm() {
        const name = document.getElementById('productName').value.trim();
        const category = document.getElementById('productCategory').value;

        // Reset errors
        document.querySelectorAll('.error-text').forEach(el => el.classList.add('hidden'));
        document.getElementById('colorError').classList.add('hidden');
        document.getElementById('variantError').classList.add('hidden');

        let valid = true;
        if (name.length < 2) { 
            document.getElementById('productNameError').textContent = 'Product name must be at least 2 characters.';
            document.getElementById('productNameError').classList.remove('hidden');
            valid = false;
        }
        if (!category) { 
            document.getElementById('productCategoryError').textContent = 'Please select a category.';
            document.getElementById('productCategoryError').classList.remove('hidden');
            valid = false;
        }

        // Collect Colors
        const colorOptions = [];
        const colorSections = document.querySelectorAll('#colorsContainer > div');
        let colorValid = true;
        
        colorSections.forEach(sec => {
            const colorId = sec.id;
            const select = sec.querySelector('[data-field="color-data"]');
            const isDefault = sec.querySelector('input[name="defaultColorRadio"]').checked;
            
            if (select && select.value) {
                try {
                    const parsed = JSON.parse(select.value);
                    const blobs = colorBlobs[colorId] || [];
                    if (blobs.length < 3) colorValid = false;
                    colorOptions.push({
                        name: parsed.name,
                        code: parsed.code,
                        isDefault: isDefault,
                        _blobId: colorId // temporary link for formdata
                    });
                } catch(e) {}
            }
        });

        if (colorOptions.length === 0 || !colorValid) {
            document.getElementById('colorError').classList.remove('hidden');
            valid = false;
        }

        // Check for duplicate color selections
        const colorNames = colorOptions.map(c => c.name);
        if (new Set(colorNames).size !== colorNames.length) {
            Swal.fire('Duplicate Colors', 'You have added the same color multiple times.', 'warning');
            valid = false;
        }

        // Collect Variants
        const variants = [];
        const variantRows = document.querySelectorAll('#variantsBody tr');
        const variantKeys = new Set();
        let variantsValid = true;
        let variantDuplicate = false;

        variantRows.forEach(row => {
            const size = row.querySelector('[data-field="size"]').value;
            const color = row.querySelector('[data-field="color"]').value;
            const price = parseFloat(row.querySelector('[data-field="price"]').value);
            const stock = parseInt(row.querySelector('[data-field="stock"]').value);

            if (!size || !color || isNaN(price) || price < 1 || isNaN(stock) || stock < 0) {
                variantsValid = false;
                return;
            }

            const key = `${size}-${color.toLowerCase()}`;
            if (variantKeys.has(key)) variantDuplicate = true;
            variantKeys.add(key);

            variants.push({ size, color, price, stock });
        });

        if (variantRows.length === 0 || !variantsValid) {
            document.getElementById('variantError').classList.remove('hidden');
            valid = false;
        }

        if (variantDuplicate) {
            Swal.fire('Duplicate Variants', 'You cannot add the same size and color combination twice.', 'warning');
            valid = false;
        }

        if (!valid) return;

        const btn = document.getElementById('submitProductBtn');
        btn.innerHTML = '⏳ Saving Product...'; 
        btn.disabled = true;

        try {
            const formData = new FormData();
            formData.append('name', name);
            formData.append('brand', document.getElementById('productBrand').value.trim());
            formData.append('category', category);
            formData.append('subcategory', document.getElementById('productSubcategory').value);
            formData.append('description', document.getElementById('productDesc').value.trim());
            formData.append('isActive', document.getElementById('productActive').checked ? 'true' : 'false');
            formData.append('isFeatured', document.getElementById('productFeatured').checked ? 'true' : 'false');
            
            // Clean _blobId from colorOptions before sending
            const cleanColorOptions = colorOptions.map(c => ({ name: c.name, code: c.code, isDefault: c.isDefault }));
            formData.append('colorOptions', JSON.stringify(cleanColorOptions));
            formData.append('variants', JSON.stringify(variants));
            
            // Append images mapping to colorOptions array index
            colorOptions.forEach((col, index) => {
                const blobs = colorBlobs[col._blobId] || [];
                blobs.forEach(blob => formData.append(`color_images_${index}`, blob));
            });

            const res = await axios.post('/admin/products/add', formData, { headers: { 'Content-Type': 'multipart/form-data' } });
            if (res.data.success) {
                Swal.fire({ title: 'Created!', text: 'Product successfully added!', icon: 'success', timer: 2000, showConfirmButton: false })
                    .then(() => window.location.href = '/admin/products');
            }
        } catch (err) {
            btn.innerHTML = 'Create Product'; 
            btn.disabled = false;

            if (err.response && err.response.data && err.response.data.errors) {
                const errors = err.response.data.errors;
                
                if (errors.name) {
                    const el = document.getElementById('productNameError');
                    el.textContent = errors.name;
                    el.classList.remove('hidden');
                }
                if (errors.category) {
                    const el = document.getElementById('productCategoryError');
                    el.textContent = errors.category;
                    el.classList.remove('hidden');
                }

                const hasColorError = Object.keys(errors).some(key => key.startsWith('colorOptions'));
                if (hasColorError) {
                    const el = document.getElementById('colorError');
                    const msg = Object.keys(errors).find(k => k.startsWith('colorOptions')) || 'Color validation failed.';
                    el.textContent = errors[msg];
                    el.classList.remove('hidden');
                }

                const hasVariantError = Object.keys(errors).some(key => key.startsWith('variants'));
                if (hasVariantError) {
                    const el = document.getElementById('variantError');
                    const msg = Object.keys(errors).find(k => k.startsWith('variants')) || 'Variant validation failed.';
                    el.textContent = errors[msg];
                    el.classList.remove('hidden');
                }

                Swal.fire('Validation Failed', 'Please check the form for errors.', 'warning');
            } else {
                Swal.fire('Error!', err.response?.data?.message || 'Something went wrong.', 'error');
            }
        }
    }

    // Initialize UI
    addColorSection();
    addVariantRow();
</script>
