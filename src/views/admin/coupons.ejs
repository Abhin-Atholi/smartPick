<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Coupon Management</h2>
        <p class="text-sm text-gray-500 mt-1">Create, edit, and monitor discount coupons</p>
    </div>
    <button onclick="openAddModal()"
        class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow-lg shadow-indigo-200 transition-all active:scale-95 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Coupon
    </button>
</div>

<!-- Filters & Search -->
<div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-6 flex flex-col md:flex-row gap-4 justify-between">
    <form action="/admin/coupons" method="GET" class="flex flex-1 gap-4" id="filterForm">
        <div class="relative flex-1 max-w-md">
            <input type="text" name="search" value="<%= search %>" placeholder="Search by Coupon Code..."
                class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-semibold outline-none text-slate-700 placeholder-gray-400">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
        </div>
        <select name="status" onchange="document.getElementById('filterForm').submit()"
            class="bg-gray-50 border border-gray-200 text-slate-700 text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 font-bold outline-none cursor-pointer">
            <option value="">All Statuses</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired</option>
        </select>
        <% if(search || status) { %>
            <a href="/admin/coupons" class="px-4 py-2.5 text-sm font-bold text-gray-500 bg-gray-100 hover:bg-gray-200 rounded-xl transition">Clear</a>
        <% } %>
    </form>
</div>

<!-- Coupons Table -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-600 whitespace-nowrap">
            <thead class="text-xs uppercase bg-gray-50 text-gray-400 font-black tracking-wider border-b border-gray-100">
                <tr>
                    <th scope="col" class="px-6 py-4">Code</th>
                    <th scope="col" class="px-6 py-4">Type & Value</th>
                    <th scope="col" class="px-6 py-4">Min Pur. / Max Dis.</th>
                    <th scope="col" class="px-6 py-4">Usage HUD</th>
                    <th scope="col" class="px-6 py-4">Expiry Date</th>
                    <th scope="col" class="px-6 py-4">Status</th>
                    <th scope="col" class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if(coupons.length > 0) { %>
                    <% coupons.forEach(coupon => { %>
                        <tr class="hover:bg-indigo-50/30 transition-colors group">
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-gray-100 text-slate-800 font-mono font-bold rounded-lg border border-gray-200 text-xs tracking-wider">
                                    <%= coupon.code %>
                                </span>
                                <% if(coupon.description) { %>
                                    <p class="text-xs text-gray-400 font-semibold mt-1 truncate max-w-[150px]" title="<%= coupon.description %>"><%= coupon.description %></p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-black text-slate-800 capitalize"><%= coupon.discountType %></span>
                                <p class="text-xs font-bold text-indigo-600 mt-0.5">
                                    <%= coupon.discountType === 'percentage' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %>
                                </p>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-xs font-bold text-gray-500">Min: <span class="text-slate-800">₹<%= coupon.minimumAmount %></span></p>
                                <% if(coupon.discountType === 'percentage') { %>
                                    <p class="text-xs font-bold text-gray-500 mt-0.5">Max Dis: <span class="text-slate-800">₹<%= coupon.maximumDiscount %></span></p>
                                <% } else { %>
                                    <p class="text-xs font-bold text-gray-300 mt-0.5">Max Dis: N/A</p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <div class="w-full bg-gray-100 rounded-full h-1.5 mb-1 max-w-[100px]">
                                    <% const usagePercent = Math.min((coupon.usedCount / coupon.usageLimit) * 100, 100); %>
                                    <div class="h-1.5 rounded-full <%= usagePercent >= 100 ? 'bg-red-500' : 'bg-indigo-500' %>" style="width: <%= usagePercent %>%"></div>
                                </div>
                                <span class="text-[10px] font-bold text-gray-400"><%= coupon.usedCount %> / <%= coupon.usageLimit %> Used</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm font-semibold text-slate-700">
                                    <%= new Date(coupon.expiryDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                </p>
                                <% if(coupon.dynamicStatus === 'Expired') { %>
                                    <p class="text-[10px] text-red-500 font-bold uppercase mt-0.5">Expired</p>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold
                                    <%= coupon.dynamicStatus === 'Active' ? 'bg-green-50 text-green-700 border border-green-200' :
                                        coupon.dynamicStatus === 'Expired' ? 'bg-red-50 text-red-700 border border-red-200' :
                                        'bg-gray-100 text-gray-600 border border-gray-200' %>">
                                    <span class="w-1.5 h-1.5 rounded-full
                                        <%= coupon.dynamicStatus === 'Active' ? 'bg-green-500' :
                                            coupon.dynamicStatus === 'Expired' ? 'bg-red-500' :
                                            'bg-gray-400' %>">
                                    </span>
                                    <%= coupon.dynamicStatus %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <button onclick="toggleCouponStatus('<%= coupon._id %>', <%= coupon.isActive %>)" 
                                    class="text-gray-400 hover:text-indigo-600 transition-colors" title="<%= coupon.isActive ? 'Deactivate' : 'Activate' %>">
                                    <% if(coupon.isActive) { %>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="5" width="22" height="14" rx="7" ry="7"></rect><circle cx="16" cy="12" r="3"></circle></svg>
                                    <% } else { %>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="5" width="22" height="14" rx="7" ry="7"></rect><circle cx="8" cy="12" r="3"></circle></svg>
                                    <% } %>
                                </button>
                                <button onclick='openEditModal(<%- JSON.stringify(coupon).replace(/'/g, "\\'") %>)' 
                                    class="text-gray-400 hover:text-blue-500 transition-colors" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </button>
                                <button onclick="deleteCoupon('<%= coupon._id %>')" 
                                    class="text-gray-400 hover:text-red-500 transition-colors" title="Delete">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="px-6 py-10 text-center">
                            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-50 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            </div>
                            <h3 class="text-sm font-bold text-slate-800">No coupons found</h3>
                            <p class="text-xs text-gray-500 mt-1">Try adjusting your search or filter to find what you're looking for.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-gray-100 bg-white flex justify-end">
            <nav class="flex items-center gap-1">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %><%= search ? '&search='+search : '' %><%= status ? '&status='+status : '' %>" 
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold transition-colors
                        <%= currentPage === i ? 'bg-indigo-600 text-white shadow-sm' : 'text-gray-500 hover:bg-gray-100 hover:text-slate-800' %>">
                        <%= i %>
                    </a>
                <% } %>
            </nav>
        </div>
    <% } %>
</div>

<!-- Coupon Modal (Add/Edit) -->
<div id="couponModal" class="fixed inset-0 z-50 hidden bg-gray-900/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl transform transition-all duration-300 scale-95 opacity-0 translate-y-4" id="couponModalContent">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 rounded-t-2xl">
            <h3 id="modalTitle" class="text-lg font-black text-slate-800">Add New Coupon</h3>
            <button onclick="closeModal()" class="text-gray-400 hover:text-red-500 transition-colors p-1 rounded-lg hover:bg-red-50">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        
        <form id="couponForm" class="p-6">
            <input type="hidden" id="couponId" name="couponId">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                <!-- Code -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Coupon Code <span class="text-red-500">*</span></label>
                    <input type="text" id="code" name="code" placeholder="e.g. SUMMER50" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-mono font-bold uppercase transition-all">
                    <p id="codeError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                    <p id="codeLockText" class="text-[10px] text-orange-500 font-bold mt-1 hidden flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Locked: Coupon already in use</p>
                </div>
                
                <!-- Description -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Description</label>
                    <input type="text" id="description" name="description" placeholder="Brief description..." class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-semibold transition-all">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                <!-- Discount Type -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Discount Type <span class="text-red-500">*</span></label>
                    <select id="discountType" name="discountType" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                        <option value="flat">Flat Amount (₹)</option>
                        <option value="percentage">Percentage (%)</option>
                    </select>
                </div>
                
                <!-- Discount Value -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Discount Value <span class="text-red-500">*</span></label>
                    <input type="number" id="discountValue" name="discountValue" min="1" step="1" placeholder="e.g. 50" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="discountValueError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
                <!-- Minimum Purchase -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Min Purchase (₹) <span class="text-red-500">*</span></label>
                    <input type="number" id="minimumAmount" name="minimumAmount" min="0" step="1" value="0" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="minimumAmountError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>

                <!-- Maximum Discount (Percentage only) -->
                <div id="maxDiscountContainer" class="opacity-50 pointer-events-none transition-all">
                    <label class="block text-[11px] font-black text-gray-500 uppercase tracking-wider mb-2">Max Discount (₹)</label>
                    <input type="number" id="maximumDiscount" name="maximumDiscount" min="1" step="1" placeholder="Required for %" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all" disabled>
                    <p id="maximumDiscountError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
                
                <!-- Usage Limit -->
                <div>
                    <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Total Limit <span class="text-red-500">*</span></label>
                    <input type="number" id="usageLimit" name="usageLimit" min="1" step="1" placeholder="e.g. 100" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all">
                    <p id="usageLimitError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-xs font-black text-gray-500 uppercase tracking-wider mb-2">Expiry Date & Time <span class="text-red-500">*</span></label>
                <input type="datetime-local" id="expiryDate" name="expiryDate" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none font-bold transition-all cursor-pointer">
                <p id="expiryDateError" class="error-msg text-[10px] text-red-500 font-bold mt-1 hidden"></p>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl font-bold text-sm text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">Cancel</button>
                <button type="submit" id="submitBtn" class="px-6 py-2.5 rounded-xl font-bold text-sm text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all active:scale-95">Save Coupon</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const modal = document.getElementById('couponModal');
    const modalContent = document.getElementById('couponModalContent');
    const form = document.getElementById('couponForm');
    const discountTypeSelect = document.getElementById('discountType');
    const maxDiscountContainer = document.getElementById('maxDiscountContainer');
    const maxDiscountInput = document.getElementById('maximumDiscount');
    const codeInput = document.getElementById('code');
    const codeLockText = document.getElementById('codeLockText');
    const discountValueInput = document.getElementById('discountValue');

    // Auto-Uppercase and No Spaces for Code Input
    codeInput.addEventListener('input', function() {
        this.value = this.value.replace(/\s+/g, '').toUpperCase();
    });

    // Dynamic Discount Type UI Handler
    discountTypeSelect.addEventListener('change', function() {
        if (this.value === 'percentage') {
            maxDiscountContainer.classList.remove('opacity-50', 'pointer-events-none');
            maxDiscountInput.disabled = false;
            discountValueInput.placeholder = "e.g. 15 (Max 90%)";
            discountValueInput.max = 90;
        } else {
            maxDiscountContainer.classList.add('opacity-50', 'pointer-events-none');
            maxDiscountInput.disabled = true;
            maxDiscountInput.value = '';
            discountValueInput.placeholder = "e.g. 500 (Flat ₹)";
            discountValueInput.max = "";
        }
    });

    function openAddModal() {
        form.reset();
        document.getElementById('couponId').value = '';
        document.getElementById('modalTitle').textContent = 'Add New Coupon';
        
        // Reset locks
        codeInput.readOnly = false;
        codeInput.classList.remove('bg-gray-200', 'text-gray-500', 'border-transparent');
        codeLockText.classList.add('hidden');
        discountTypeSelect.disabled = false;
        discountTypeSelect.classList.remove('bg-gray-200', 'text-gray-500');
        
        discountTypeSelect.dispatchEvent(new Event('change')); // Trigger UI update
        
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
        }, 10);
    }

    function openEditModal(coupon) {
        form.reset();
        document.getElementById('couponId').value = coupon._id;
        document.getElementById('modalTitle').textContent = 'Edit Coupon: ' + coupon.code;
        
        codeInput.value = coupon.code;
        document.getElementById('description').value = coupon.description || '';
        discountTypeSelect.value = coupon.discountType;
        discountValueInput.value = coupon.discountValue;
        document.getElementById('minimumAmount').value = coupon.minimumAmount;
        document.getElementById('usageLimit').value = coupon.usageLimit;
        
        if(coupon.maximumDiscount) {
            maxDiscountInput.value = coupon.maximumDiscount;
        }

        // Format Date for datetime-local input
        const d = new Date(coupon.expiryDate);
        const pad = n => n < 10 ? '0' + n : n;
        const formattedDate = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
        document.getElementById('expiryDate').value = formattedDate;

        // Security Lock check
        if (coupon.usedCount > 0) {
            codeInput.readOnly = true;
            codeInput.classList.add('bg-gray-200', 'text-gray-500', 'border-transparent');
            codeLockText.classList.remove('hidden');
            
            // Also lock discount type/value according to rules
            discountTypeSelect.disabled = true;
            discountTypeSelect.classList.add('bg-gray-200', 'text-gray-500');
        } else {
            codeInput.readOnly = false;
            codeInput.classList.remove('bg-gray-200', 'text-gray-500', 'border-transparent');
            codeLockText.classList.add('hidden');
            
            discountTypeSelect.disabled = false;
            discountTypeSelect.classList.remove('bg-gray-200', 'text-gray-500');
        }

        discountTypeSelect.dispatchEvent(new Event('change')); // Trigger UI update
        
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
        }, 10);
    }

    function closeModal() {
        modal.classList.add('opacity-0');
        modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    // Form Submit
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = 'Saving...';

        // --- Custom Frontend Validation ---
        let hasError = false;
        
        function showError(inputId, errorId, message) {
            const input = document.getElementById(inputId);
            const errEl = document.getElementById(errorId);
            if(input) {
                input.classList.add('border-red-500', 'focus:ring-red-500');
                input.classList.remove('border-gray-200', 'focus:ring-indigo-500');
            }
            if(errEl) {
                errEl.textContent = message;
                errEl.classList.remove('hidden');
            }
            hasError = true;
        }

        function clearErrors() {
            document.querySelectorAll('.error-msg').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('input, select').forEach(el => {
                el.classList.remove('border-red-500', 'focus:ring-red-500');
                el.classList.add('border-gray-200', 'focus:ring-indigo-500');
            });
        }

        clearErrors();

        const codeVal = codeInput.value.trim();
        if (!codeVal) {
            showError('code', 'codeError', 'Coupon code is required.');
        } else if (codeVal.length < 3) {
            showError('code', 'codeError', 'Code must be at least 3 characters.');
        }

        const dType = discountTypeSelect.value;
        const dValueStr = discountValueInput.value;
        const dValue = Number(dValueStr);
        
        if (!dValueStr) {
            showError('discountValue', 'discountValueError', 'Discount value is required.');
        } else if (dValue < 1) {
            showError('discountValue', 'discountValueError', 'Must be at least 1.');
        } else if (dType === 'percentage' && dValue > 90) {
            showError('discountValue', 'discountValueError', 'Percentage cannot exceed 90%.');
        }

        const mAmountStr = document.getElementById('minimumAmount').value;
        const mAmount = Number(mAmountStr);
        if (!mAmountStr) {
            showError('minimumAmount', 'minimumAmountError', 'Minimum purchase is required.');
        } else if (mAmount < 0) {
            showError('minimumAmount', 'minimumAmountError', 'Cannot be negative.');
        } else if (dType === 'flat' && dValue >= mAmount) {
            showError('minimumAmount', 'minimumAmountError', 'Min purchase must be greater than flat discount.');
        }

        if (dType === 'percentage') {
            const maxDStr = maxDiscountInput.value;
            const maxD = Number(maxDStr);
            if (!maxDStr) {
                showError('maximumDiscount', 'maximumDiscountError', 'Required for percentage type.');
            } else if (maxD < 1) {
                showError('maximumDiscount', 'maximumDiscountError', 'Must be at least 1.');
            }
        }

        const uLimitStr = document.getElementById('usageLimit').value;
        const uLimit = Number(uLimitStr);
        if (!uLimitStr) {
            showError('usageLimit', 'usageLimitError', 'Usage limit is required.');
        } else if (uLimit < 1) {
            showError('usageLimit', 'usageLimitError', 'Must be at least 1.');
        }

        const expDate = document.getElementById('expiryDate').value;
        if (!expDate) {
            showError('expiryDate', 'expiryDateError', 'Expiry date is required.');
        } else if (new Date(expDate) <= new Date()) {
            showError('expiryDate', 'expiryDateError', 'Expiry date must be in the future.');
        }

        if (hasError) {
            btn.disabled = false;
            btn.innerHTML = 'Save Coupon';
            return;
        }
        // --- End Validation ---

        const id = document.getElementById('couponId').value;
        const isEdit = !!id;
        
        // Re-enable disabled fields momentarily to serialize
        const tempDisabled = Array.from(form.querySelectorAll(':disabled'));
        tempDisabled.forEach(el => el.disabled = false);
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        // Restore disabled
        tempDisabled.forEach(el => el.disabled = true);

        try {
            const url = isEdit ? `/admin/coupons/edit/${id}` : '/admin/coupons/add';
            const response = await (isEdit ? axios.patch(url, data) : axios.post(url, data));

            if (response.data.success) {
                Swal.fire({ icon: 'success', title: 'Success', text: response.data.message, timer: 1500, showConfirmButton: false })
                    .then(() => window.location.reload());
            }
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Error', text: error.response?.data?.message || 'Something went wrong!' });
            btn.disabled = false;
            btn.innerHTML = 'Save Coupon';
        }
    });

    // Toggle Status
    async function toggleCouponStatus(id, currentStatus) {
        try {
            const res = await axios.patch(`/admin/coupons/toggle/${id}`);
            if (res.data.success) {
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.data.message, showConfirmButton: false, timer: 2000 });
                setTimeout(() => window.location.reload(), 1000);
            }
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to update status' });
        }
    }

    // Delete
    function deleteCoupon(id) {
        Swal.fire({
            title: 'Delete Coupon?',
            text: 'This will soft-delete the coupon, preventing future uses. Existing orders will not be affected.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#9ca3af',
            confirmButtonText: 'Yes, delete it!'
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    const res = await axios.delete(`/admin/coupons/delete/${id}`);
                    if (res.data.success) {
                        Swal.fire({ icon: 'success', title: 'Deleted!', text: 'Coupon has been removed.', timer: 1500, showConfirmButton: false })
                            .then(() => window.location.reload());
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to delete coupon' });
                }
            }
        });
    }
</script>
