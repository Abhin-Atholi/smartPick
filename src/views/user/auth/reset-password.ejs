<div class="min-h-screen bg-gray-100 flex items-center justify-center p-5">
  <div class="w-full max-w-md bg-white rounded-xl shadow-lg border border-gray-100 p-8">
    <h1 class="text-2xl font-black text-center">Reset Password</h1>
    <p class="text-sm text-gray-500 text-center mt-1 mb-6">Enter OTP + new password</p>

    <div class="mb-6 text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-gray-400">OTP Expires In</span>
      <div id="expiryTimer" class="text-2xl font-mono font-bold text-indigo-600">--:--</div>
    </div>

    <% if (msg) { %>
      <% const isSuccess = msg.includes('successful') || msg.includes('✅'); %>
      <div class="mb-4 text-sm <%= isSuccess ? 'text-green-600' : 'text-red-600' %> text-center font-semibold"><%= msg.replace('✅', '').trim() %></div>
    <% } %>

    <form id="resetPasswordForm" method="POST" action="/reset-password" class="space-y-4">
      <input type="hidden" name="email" value="<%= email %>">

      <input name="otp" id="otpInput" maxlength="6" placeholder="6-digit OTP" 
        class="w-full text-center tracking-widest rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 outline-none focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"/>

      <div class="relative">
        <input name="password" type="password" id="password" placeholder="New password" 
          class="w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 outline-none focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"/>
        <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 focus:outline-none toggle-password" data-target="password">
          <svg class="w-5 h-5 eye-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.352 7.088 7.423 4.75 12 4.75s8.648 2.338 9.964 6.928a1.012 1.012 0 0 1 0 .644c-1.316 4.908-5.387 7.246-12 7.246s-8.648-2.338-9.964-6.928Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          <svg class="w-5 h-5 eye-slash-icon hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.822 7.822L21 21m-7.778-7.778-3.65-3.65m0 0a3 3 0 1 0 5.148 5.148m-5.148-5.148 3.65 3.65" />
          </svg>
        </button>
      </div>

      <div class="relative">
        <input name="confirmPassword" type="password" id="confirmPassword" placeholder="Confirm password" 
          class="w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 outline-none focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"/>
        <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 focus:outline-none toggle-password" data-target="confirmPassword">
          <svg class="w-5 h-5 eye-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.352 7.088 7.423 4.75 12 4.75s8.648 2.338 9.964 6.928a1.012 1.012 0 0 1 0 .644c-1.316 4.908-5.387 7.246-12 7.246s-8.648-2.338-9.964-6.928Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          <svg class="w-5 h-5 eye-slash-icon hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.822 7.822L21 21m-7.778-7.778-3.65-3.65m0 0a3 3 0 1 0 5.148 5.148m-5.148-5.148 3.65 3.65" />
          </svg>
        </button>
      </div>

      <button type="submit" id="submitBtn" class="w-full rounded-lg bg-indigo-600 text-white font-black py-3 hover:bg-indigo-700 transition disabled:bg-gray-400">
        Reset Password
      </button>
    </form>

    <form method="POST" action="/resend-reset-otp" class="mt-4">
      <input type="hidden" name="email" value="<%= email %>">
      <button
        id="resendBtn"
        type="submit"
        class="w-full rounded-lg border border-gray-200 bg-white py-3 font-bold hover:bg-gray-50 transition disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Resend OTP <span id="timerText"></span>
      </button>
    </form>

    <div class="mt-5 text-center text-sm">
      <a href="/login" class="font-bold hover:underline text-indigo-600">Back to Login</a>
    </div>
  </div>
</div>

<script>
  // Get time from backend (remainingSeconds should be calculated in loadResetPassword)
  let timeLeft = parseInt("<%= typeof remainingSeconds !== 'undefined' ? remainingSeconds : 0 %>") || 0;

  const expiryDisplay = document.getElementById("expiryTimer");
  const resendBtn = document.getElementById("resendBtn");
  const resendTimerText = document.getElementById("timerText");
  const submitBtn = document.getElementById("submitBtn");
  const otpInput = document.getElementById("otpInput");

  function startCountdown() {
    const timerInterval = setInterval(() => {
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        expiryDisplay.textContent = "EXPIRED";
        expiryDisplay.style.color = "red";
        
        if(submitBtn) submitBtn.disabled = true;
        if(otpInput) otpInput.disabled = true;
        resendBtn.disabled = false;
        resendTimerText.textContent = ""; 
      } else {
        const m = Math.floor(timeLeft / 60);
        const s = timeLeft % 60;
        expiryDisplay.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        
        resendBtn.disabled = true;
        resendTimerText.textContent = ` (Wait ${timeLeft}s)`;
        timeLeft--;
      }
    }, 1000);
  }

  if (timeLeft > 0) {
    startCountdown();
  } else {
    expiryDisplay.textContent = "EXPIRED";
    expiryDisplay.style.color = "red";
    resendBtn.disabled = false;
    if(submitBtn) submitBtn.disabled = true;
  }

  // Password Toggles
  document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', function() {
          const targetId = this.getAttribute('data-target');
          const input = document.getElementById(targetId);
          const eyeIcon = this.querySelector('.eye-icon');
          const eyeSlashIcon = this.querySelector('.eye-slash-icon');
          
          if (input.type === 'password') {
              input.type = 'text';
              eyeIcon.classList.add('hidden');
              eyeSlashIcon.classList.remove('hidden');
          } else {
              input.type = 'password';
              eyeIcon.classList.remove('hidden');
              eyeSlashIcon.classList.add('hidden');
          }
      });
  });
</script>

<script src="/js/validation.js"></script>
<script src="/js/authValidation.js"></script>