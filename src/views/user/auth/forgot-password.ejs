<div class="min-h-screen flex items-center justify-center bg-gray-100 p-5">
  <div class="w-full max-w-md bg-white rounded-xl shadow p-8">
    <h2 class="text-2xl font-black text-center mb-4">Forgot Password</h2>

    <% if (msg) { %>
      <% const isSuccess = msg.includes('successful') || msg.includes('✅'); %>
      <div class="<%= isSuccess ? 'text-green-600' : 'text-red-500' %> text-sm mb-4 text-center"><%= msg.replace('✅', '').trim() %></div>
    <% } %>

    <form id="forgotPasswordForm" method="POST" action="/forgot-password" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <input name="email" type="email" placeholder="Enter your email" required
        class="w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 outline-none focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" />

      <button type="submit" class="w-full bg-indigo-600 text-white font-black py-3 rounded-lg hover:bg-indigo-700 transition">
        Send OTP
      </button>
    </form>
  </div>
</div>

<script src="/js/validation.js"></script>
<script src="/js/authValidation.js"></script>
