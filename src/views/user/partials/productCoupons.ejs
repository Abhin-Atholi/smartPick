<!-- Dynamic Links for Product Coupons and Offers -->
<div class="mb-10">
  <div class="flex items-center gap-6">
    <!-- View Offers Link -->
    <button onclick="openOffersModal()" class="group flex items-center gap-2 transition-all">
      <div class="w-8 h-8 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
      </div>
      <span class="text-[11px] font-black text-slate-900 uppercase tracking-widest border-b-2 border-indigo-100 group-hover:border-indigo-600 transition-all duration-300">View Offers</span>
    </button>

    <!-- View Coupons Link -->
    <button onclick="openCouponsModal()" class="group flex items-center gap-2 transition-all">
      <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
      </div>
      <span class="text-[11px] font-black text-slate-900 uppercase tracking-widest border-b-2 border-emerald-100 group-hover:border-emerald-600 transition-all duration-300">View Coupons</span>
    </button>
  </div>
</div>
