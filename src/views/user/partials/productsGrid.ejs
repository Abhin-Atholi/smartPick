<!-- PARTIAL: productsGrid -->

<div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-6">
  <% if (typeof products !=='undefined' && products.length> 0) { %>
    <% products.forEach(p=> { %>
      <% 
        const minPrice = p.variants && p.variants.length > 0
          ? Math.min(...p.variants.map(v => v.price))
          : 0;
        const formattedPrice = `₹${minPrice.toLocaleString()}`;
        const firstImage = p.defaultImage || 'https://placehold.co/600x700?text=No+Image';
        const catName = p.category ? p.category.name : 'Uncategorized';
        const isOutOfStock = !p.variants || p.variants.length === 0 || p.variants.every(v => (v.stock || 0) === 0);
        %>
        <article class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-slate-200/80 hover:-translate-y-0.5 transition-all duration-300 group flex flex-col h-full relative <%= isOutOfStock ? 'opacity-85' : '' %>">
          <div class="relative bg-gray-50 aspect-[4/5] overflow-hidden">
            <% if(p.isFeatured){ %>
              <span class="absolute left-2.5 top-2.5 z-10 text-[8px] md:text-[9px] font-black bg-amber-500 text-white px-2 py-0.5 md:px-2.5 md:py-1 rounded-md uppercase tracking-wider shadow-sm">Featured</span>
            <% } %>
            <a href="/products/details/<%= p._id %>" class="block w-full h-full relative">
              <img class="w-full h-full object-cover transition-transform duration-700 <%= isOutOfStock ? '' : 'group-hover:scale-105' %>"
                src="<%= firstImage %>" alt="<%= p.name %>" loading="lazy">
              <% if (isOutOfStock) { %>
                <div class="absolute inset-0 bg-slate-900/30 backdrop-blur-[1px] flex items-center justify-center pointer-events-none z-10">
                  <span class="bg-slate-950/90 text-white text-[9px] md:text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded shadow-sm">
                    Sold Out
                  </span>
                </div>
              <% } %>
            </a>

            <!-- Wishlist Heart Button -->
            <button onclick="toggleWishlist(this, '<%= p._id %>')" 
                    class="absolute top-2 right-2 md:top-3 md:right-3 z-10 w-7 h-7 md:w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm border border-slate-100 flex items-center justify-center transition-all hover:bg-white hover:scale-105 active:scale-95 <%= (typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(p._id.toString())) ? 'text-red-500 border-red-100 shadow-sm' : 'text-slate-400' %>">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" class="md:w-4 md:h-4" viewBox="0 0 24 24" 
                   fill="<%= (typeof wishlistProductIds !== 'undefined' && wishlistProductIds.includes(p._id.toString())) ? 'currentColor' : 'none' %>" 
                   stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>

          <div class="p-3.5 sm:p-5 flex flex-col flex-1">
            <div class="mb-2.5">
              <% if (p.brand) { %>
                <p class="text-[9px] sm:text-[10px] text-slate-400 font-black uppercase tracking-wider mb-1"><%= p.brand.toUpperCase() %></p>
              <% } %>
              <a href="/products/details/<%= p._id %>">
                <h3 class="font-bold text-slate-800 text-xs sm:text-sm truncate hover:text-indigo-600 transition-colors">
                  <%= p.name %>
                </h3>
              </a>
              <p class="text-[9px] sm:text-[10px] text-slate-500/60 font-bold uppercase tracking-wider mt-0.5"><%= catName %></p>
            </div>

            <!-- Variants Preview: Sizes & Colors -->
            <div class="flex flex-col gap-2 md:gap-3 mb-3.5 mt-auto">
              <% 
                const uniqueColors = p.colorOptions || [];
              %>
              <% if (uniqueColors.length > 0) { %>
                <div class="flex gap-1 items-center overflow-x-auto scrollbar-none pb-0.5 flex-nowrap [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                  <% uniqueColors.slice(0, 6).forEach(c => { %>
                    <span class="flex-shrink-0 w-2.5 h-2.5 md:w-3 md:h-3 rounded-full border border-slate-200/80 shadow-sm hover:scale-110 transition-transform" style="background-color: <%= c.code %>" title="<%= c.name %>"></span>
                  <% }) %>
                  <% if(uniqueColors.length > 6) { %>
                    <span class="flex-shrink-0 text-[8px] md:text-[9px] font-bold text-slate-400 ml-0.5">+<%= uniqueColors.length - 6 %></span>
                  <% } %>
                </div>
              <% } %>
              
              <div class="flex items-center gap-1 overflow-x-auto scrollbar-none pb-0.5 flex-nowrap [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                <% PRODUCT_SIZES.forEach(size => { 
                     const isAvailable = p.variants.some(v => String(v.size || '').trim().toLowerCase() === String(size).trim().toLowerCase() && v.stock > 0);
                %>
                  <span class="flex-shrink-0 text-[8px] md:text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded border <%= isAvailable ? 'text-slate-600 border-slate-200 bg-slate-50/50' : 'text-slate-300 border-slate-100 opacity-40 cursor-not-allowed relative overflow-hidden' %>">
                    <%= size %>
                    <% if(!isAvailable) { %>
                      <div class="absolute inset-0 w-full h-full border-t border-slate-300" style="transform: translateY(50%) rotate(-45deg);"></div>
                    <% } %>
                  </span>
                <% }) %>
              </div>
            </div>

            <div class="pt-2.5 md:pt-3 border-t border-slate-100 flex items-center justify-between gap-1.5 mt-auto">
              <div>
                <% 
                  const bestOffer = p.bestOffer;
                  const hasOffer = !!bestOffer;
                  const finalPrice = hasOffer ? bestOffer.finalPrice : minPrice;
                %>
                <p class="text-[8px] md:text-[9px] text-slate-400 font-bold uppercase tracking-wider">Price</p>
                <div class="flex items-baseline gap-1 md:gap-1.5 flex-wrap">
                  <span class="font-black text-xs md:text-sm lg:text-base text-slate-900">₹<%= finalPrice.toLocaleString() %></span>
                  <% if(hasOffer) { %>
                    <span class="text-[9px] md:text-[10px] text-slate-400 line-through font-medium">₹<%= minPrice.toLocaleString() %></span>
                  <% } %>
                </div>
              </div>
              <% if(hasOffer) { %>
                <span class="px-1.5 md:px-2 py-0.5 bg-rose-50 text-rose-600 text-[8px] md:text-[9px] font-black uppercase tracking-wider rounded-md border border-rose-100 shrink-0">
                  <%= bestOffer.discountType === 'flat' ? '₹' + bestOffer.discountValue + ' OFF' : bestOffer.discountValue + '% OFF' %>
                </span>
              <% } %>
            </div>
          </div>
        </article>
        <% }) %>
          <% } else { %>
            <div class="col-span-full py-20 text-center bg-gray-50 rounded-3xl border-2 border-dashed border-gray-100">
              <div class="text-5xl mb-4">📦</div>
              <p class="text-gray-400 font-bold">No products found for this criteria.</p>
              <a href="/products" class="text-indigo-600 hover:underline mt-2 inline-block">Browse all →</a>
            </div>
            <% } %>
</div>