<aside class="bg-white border border-gray-100 rounded-2xl shadow-sm p-3 h-fit">
  <a href="/account"
     class="flex items-center gap-3 px-4 py-3 rounded-xl <%= active === 'profile' ? 'bg-indigo-50 font-black text-indigo-700' : 'hover:bg-gray-50 text-gray-600 font-bold' %>">
    <span class="w-7 h-7 rounded-full <%= active === 'profile' ? 'bg-indigo-100' : 'bg-gray-200' %> grid place-items-center">👤</span>
    Profile Information
  </a>

  <a href="/account/addresses"
     class="flex items-center gap-3 px-4 py-3 rounded-xl <%= active === 'addresses' ? 'bg-indigo-50 font-black text-indigo-700' : 'hover:bg-gray-50 text-gray-600 font-bold' %>">
    <span class="w-7 h-7 rounded-full <%= active === 'addresses' ? 'bg-indigo-100' : 'bg-gray-200' %> grid place-items-center">📍</span>
    Saved Addresses
  </a>

  <a href="/account/security"
     class="flex items-center gap-3 px-4 py-3 rounded-xl <%= active === 'security' ? 'bg-indigo-50 font-black text-indigo-700' : 'hover:bg-gray-50 text-gray-600 font-bold' %>">
    <span class="w-7 h-7 rounded-full <%= active === 'security' ? 'bg-indigo-100' : 'bg-gray-200' %> grid place-items-center">🛡️</span>
    Security Settings
  </a>

  <a href="/wallet"
     class="flex items-center gap-3 px-4 py-3 rounded-xl <%= active === 'wallet' ? 'bg-indigo-50 font-black text-indigo-700' : 'hover:bg-gray-50 text-gray-600 font-bold' %>">
