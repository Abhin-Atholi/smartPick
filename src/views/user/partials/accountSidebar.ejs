    My Wallet
  </a>

  <a href="/account/referrals"
     class="flex items-center gap-3 px-4 py-3 rounded-xl <%= active === 'referrals' ? 'bg-indigo-50 font-black text-indigo-700' : 'hover:bg-gray-50 text-gray-600 font-bold' %>">
    <span class="w-7 h-7 rounded-full <%= active === 'referrals' ? 'bg-indigo-100' : 'bg-gray-200' %> grid place-items-center">🎁</span>
    My Referrals
  </a>
</aside>
