<footer class="bg-slate-900 text-gray-300 mt-10">
  <div class="max-w-6xl mx-auto px-4 py-14 grid sm:grid-cols-2 lg:grid-cols-5 gap-8 border-b border-gray-800">
    <!-- COLUMN 1: Brand -->
    <div class="lg:col-span-1">
      <a href="/" class="flex items-center gap-2 mb-4 shrink-0">
        <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white font-black grid place-items-center text-sm shadow-sm shadow-indigo-300/20">S</div>
        <span class="font-black text-white text-lg tracking-tight">SmartPick</span>
      </a>
      <p class="text-xs text-gray-400 leading-relaxed pr-4">Premium fashion for the modern lifestyle. Quality curated for you, ensuring every piece meets our highest standards of excellence.</p>
    </div>

    <!-- COLUMN 2: Shop -->
    <div>
      <h3 class="font-black text-white uppercase tracking-widest text-xs mb-4">Shop</h3>
      <div class="space-y-3">
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/products">All Products</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/products?sort=new">New Arrivals</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/products?sort=popularity">Best Sellers</a>
      </div>
    </div>

    <!-- COLUMN 3: Categories Dropdown / List -->
    <div>
      <h3 class="font-black text-white uppercase tracking-widest text-xs mb-4">Categories</h3>
      <div class="space-y-3">
        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/products?category=<%= encodeURIComponent(cat.name) %>"><%= cat.name %></a>
          <% }) %>
        <% } else { %>
          <span class="text-sm text-gray-500">No categories</span>
        <% } %>
      </div>
    </div>

    <!-- COLUMN 4: My Space -->
    <div>
      <h3 class="font-black text-white uppercase tracking-widest text-xs mb-4">My Space</h3>
      <div class="space-y-3">
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/account">My Account</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/orders">Orders</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/wishlist">Wishlist</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="/wallet">Wallet</a>
      </div>
    </div>

    <!-- COLUMN 5: Support -->
    <div>
      <h3 class="font-black text-white uppercase tracking-widest text-xs mb-4">Support</h3>
      <div class="space-y-3">
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="mailto:support@smartpick.com">support@smartpick.com</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="tel:+918005550199">+91 800 555 0199</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="#">Delivery Policy</a>
        <a class="block text-sm text-gray-400 hover:text-white hover:translate-x-1 transition-all" href="#">Return Policy</a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-xs text-gray-500 font-bold uppercase tracking-widest">
      © <%= new Date().getFullYear() %> SmartPick. All rights reserved.
    </div>
    <!-- Bottom Bar: Social Icons -->
    <div class="flex items-center gap-4">
      <a href="#" class="text-gray-500 hover:text-white transition-colors" title="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </a>
      <a href="#" class="text-gray-500 hover:text-white transition-colors" title="Twitter/X">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
      </a>
      <a href="#" class="text-gray-500 hover:text-white transition-colors" title="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
      </a>
      <a href="#" class="text-gray-500 hover:text-white transition-colors" title="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
      </a>
    </div>
  </div>
</footer>
