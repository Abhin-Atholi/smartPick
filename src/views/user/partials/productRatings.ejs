<!-- Dynamic Output for Product Ratings -->
<div class="flex items-center gap-3 mb-2">
  <div class="flex items-center gap-0.5">
    <% for (let i = 1; i <= 5; i++) { %>
      <% if (product.averageRating >= i) { %>
        <svg class="w-4 h-4 text-amber-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
      <% } else if (product.averageRating >= i - 0.5) { %>
        <svg class="w-4 h-4 text-amber-400" viewBox="0 0 20 20">
           <defs>
             <linearGradient id="half-rating-<%= i %>">
               <stop offset="50%" stop-color="currentColor"/>
               <stop offset="50%" stop-color="#E5E7EB" stop-opacity="1"/>
             </linearGradient>
           </defs>
           <path fill="url(#half-rating-<%= i %>)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      <% } else { %>
        <svg class="w-4 h-4 text-gray-200 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
      <% } %>
    <% } %>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-sm font-bold text-slate-900"><%= product.averageRating > 0 ? product.averageRating.toFixed(1) : '0.0' %></span>
    <span class="w-1 h-1 rounded-full bg-gray-300"></span>
    <a href="#reviews" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors cursor-pointer"><%= product.reviewCount || 0 %> Reviews</a>
  </div>
</div>
