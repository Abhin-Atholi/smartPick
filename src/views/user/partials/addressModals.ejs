      <div class="px-8 py-6 border-b border-gray-100 flex justify-between items-center bg-white/80 sticky top-0 z-10">
        <div>
          <h3 class="text-2xl font-black text-gray-900">Edit Address</h3>
          <p class="text-xs text-gray-400 font-bold mt-1">Update your delivery details</p>
        </div>
        <button type="button" onclick="closeEditModal()" class="text-gray-400 hover:text-gray-900 hover:bg-gray-100 p-2 rounded-full transition-colors">
