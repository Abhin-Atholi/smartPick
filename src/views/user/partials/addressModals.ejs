                  class="flex-1 py-4 bg-indigo-600 text-white rounded-xl font-black hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 active:scale-[0.98] flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                  Update Address
                </button>
              </div>
            </form>
      </div>
    </div>
  </div>

  <script src="/js/validation.js"></script>
  <script src="/js/user/address/addressValidation.js"></script>
  <script src="/js/user/address/pincodeAutofill.js"></script>
  <script src="/js/user/address/addressHelpers.js"></script>
  <script>
    // ── Modal helpers ────────────────────────────────────────────────────────
    function _showModal(id) {
      const overlay = document.getElementById(id);
      const box     = overlay.querySelector('[data-modal-box]');
      overlay.classList.remove('hidden');
      // Trigger transition on next frame
      requestAnimationFrame(() => {
        overlay.classList.add('modal-visible');
        if (box) box.classList.add('modal-box-visible');
      });
    }

    function _hideModal(id) {
      const overlay = document.getElementById(id);
      const box     = overlay.querySelector('[data-modal-box]');
      overlay.classList.remove('modal-visible');
      if (box) box.classList.remove('modal-box-visible');
      setTimeout(() => overlay.classList.add('hidden'), 250);
    }

    function _resetForm(formId) {
      const form = document.getElementById(formId);
      if (!form) return;
      Array.from(form.elements).forEach(el => ValidationHelper.clearError(el));
      const errBox = document.getElementById(formId === 'addAddressForm' ? 'addModalError' : 'editModalError');
      if (errBox) errBox.classList.add('hidden');
    }

    // ---- Add Modal ----
    function openAddModal()  { _showModal('addAddressModal'); }
    function closeAddModal() { _hideModal('addAddressModal'); _resetForm('addAddressForm'); }

    // ---- Edit Modal ----
    function openEditModal(btn) {
      const id = btn.dataset.id;
      document.getElementById('editAddressForm').dataset.action = `/account/addresses/${id}`;
      document.getElementById('edit-fullName').value  = btn.dataset.fullname  || '';
      document.getElementById('edit-phone').value     = btn.dataset.phone     || '';
      document.getElementById('edit-pincode').value   = btn.dataset.pincode   || '';
      document.getElementById('edit-state').value     = btn.dataset.state     || '';
      document.getElementById('edit-city').value      = btn.dataset.city      || '';
      document.getElementById('edit-locality').value  = btn.dataset.locality  || '';
      document.getElementById('edit-house').value     = btn.dataset.house     || '';
      document.getElementById('edit-area').value      = btn.dataset.area      || '';
      document.getElementById('edit-isDefault').checked = btn.dataset.isdefault === 'true';
      _resetForm('editAddressForm');
      _showModal('editAddressModal');
    }
    function closeEditModal() { _hideModal('editAddressModal'); }

    // Close on backdrop click
    ['addAddressModal', 'editAddressModal'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('click', e => { if (e.target === el) el.id === 'addAddressModal' ? closeAddModal() : closeEditModal(); });
    });

    // Auto-open on backend error
    <% if (typeof modalType !== "undefined" && modalType === "add") { %>
      openAddModal();
    <% } %>
    <% if (typeof modalType !== "undefined" && modalType === "edit") { %>
      <% if (typeof editAddressData !== "undefined" && editAddressData) { %>
        document.getElementById('editAddressForm').dataset.action = `/account/addresses/<%= editAddressData._id %>`;
        document.getElementById('edit-fullName').value  = `<%= editAddressData.fullName  || '' %>`;
        document.getElementById('edit-phone').value     = `<%= editAddressData.phone     || '' %>`;
        document.getElementById('edit-pincode').value   = `<%= editAddressData.pincode   || '' %>`;
        document.getElementById('edit-state').value     = `<%= editAddressData.state     || '' %>`;
        document.getElementById('edit-city').value      = `<%= editAddressData.city      || '' %>`;
        document.getElementById('edit-locality').value  = `<%= editAddressData.locality  || '' %>`;
        document.getElementById('edit-house').value     = `<%= editAddressData.house     || '' %>`;
        document.getElementById('edit-area').value      = `<%= editAddressData.area      || '' %>`;
        document.getElementById('edit-isDefault').checked = <%= !!editAddressData.isDefault %>;
      <% } %>
      _showModal('editAddressModal');
    <% } %>
  </script>

  <style>
    /* Modal transition */
    #addAddressModal, #editAddressModal {
      opacity: 0;
      transition: opacity 0.2s ease;
      pointer-events: none;
    }
    #addAddressModal.modal-visible, #editAddressModal.modal-visible {
      opacity: 1;
      pointer-events: auto;
    }
    #addAddressModal.hidden, #editAddressModal.hidden {
      opacity: 0;
    }
    [data-modal-box] {
      transform: scale(0.95) translateY(8px);
      transition: transform 0.25s cubic-bezier(.22,.68,0,1.2);
    }
    .modal-box-visible {
      transform: scale(1) translateY(0) !important;
    }
    /* Green flash on autofill */
    .bg-indigo-50 { background-color: #eef2ff; transition: background-color 0.4s ease; }
  </style>
