  <!-- ===================== ADD ADDRESS MODAL ===================== -->
  <div id="addAddressModal"
    class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div data-modal-box class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="p-6 border-b flex justify-between items-center">
        <h3 class="text-xl font-black">Add New Address</h3>
        <button type="button" onclick="closeAddModal()" class="text-gray-400 hover:text-black transition text-xl">✕</button>
      </div>

      <div class="overflow-y-auto flex-1">
        <% if (typeof modalError !=="undefined" && modalError && (typeof modalType==="undefined" || modalType==="add" ))
          { %>
          <div class="mx-6 mt-6 p-4 text-sm font-bold rounded-xl bg-red-50 text-red-700 border border-red-100">
            <%= modalError %>
          </div>
          <% } %>
          <div id="addModalError" class="hidden mx-6 mt-6 p-4 text-sm font-bold rounded-xl bg-red-50 text-red-700 border border-red-100"></div>

            <form id="addAddressForm" class="p-6 grid md:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Full Name</label>
                <input id="add-fullName" name="fullName" placeholder="e.g. Rahul Sharma"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.fullName || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Phone Number</label>
                <input id="add-phone" name="phone" placeholder="10-digit mobile number" inputmode="numeric" maxlength="10"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.phone || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Pincode</label>
                <input id="add-pincode" name="pincode" placeholder="6-digit pincode" inputmode="numeric" maxlength="6"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.pincode || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">State</label>
                <input id="add-state" name="state" placeholder="Auto-filled from pincode"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.state || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">City</label>
                <input id="add-city" name="city" placeholder="Auto-filled from pincode"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.city || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Locality</label>
                <input id="add-locality" name="locality" placeholder="Locality / Town / Area"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.locality || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="md:col-span-2 space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">House / Building</label>
                <input id="add-house" name="house" placeholder="e.g. Flat 4B, Sunrise Apartments"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.house || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="md:col-span-2 space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Area / Street</label>
                <input id="add-area" name="area" placeholder="e.g. MG Road, Sector 14, Andheri West"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.area || '' : '' %>"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="md:col-span-2 flex items-center gap-2 pt-2">
                <input type="checkbox" id="add-isDefault" name="isDefault"
                  <%= (typeof addAddressData !== 'undefined' && addAddressData && addAddressData.isDefault) ? 'checked' : '' %>
                  class="w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-indigo-500 focus:ring-2 cursor-pointer">
                <label for="add-isDefault" class="text-sm font-bold text-gray-700 cursor-pointer">Set as default address</label>
              </div>

              <div class="md:col-span-2 flex gap-3 pt-2 border-t">
                <button type="button" onclick="closeAddModal()"
                  class="flex-1 py-3 border rounded-xl font-bold hover:bg-gray-50 transition">Cancel</button>
                <button type="submit"
                  class="flex-1 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-100">Save
                  Address</button>
              </div>
            </form>
      </div>
    </div>
  </div>

  <!-- ===================== EDIT ADDRESS MODAL ===================== -->
  <div id="editAddressModal"
    class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div data-modal-box class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="p-6 border-b flex justify-between items-center">
        <h3 class="text-xl font-black">Edit Address</h3>
        <button type="button" onclick="closeEditModal()" class="text-gray-400 hover:text-black transition text-xl">✕</button>
      </div>

      <div class="overflow-y-auto flex-1">
        <% if (typeof modalError !=="undefined" && modalError && modalType==="edit" ) { %>
          <div class="mx-6 mt-6 p-4 text-sm font-bold rounded-xl bg-red-50 text-red-700 border border-red-100">
            <%= modalError %>
          </div>
          <% } %>
          <div id="editModalError" class="hidden mx-6 mt-6 p-4 text-sm font-bold rounded-xl bg-red-50 text-red-700 border border-red-100"></div>

            <form id="editAddressForm" data-action="" class="p-6 grid md:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Full Name</label>
                <input id="edit-fullName" name="fullName"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Phone Number</label>
                <input id="edit-phone" name="phone" placeholder="10-digit mobile number" inputmode="numeric" maxlength="10"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Pincode</label>
                <input id="edit-pincode" name="pincode" placeholder="6-digit pincode" inputmode="numeric" maxlength="6"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">State</label>
                <input id="edit-state" name="state" placeholder="State"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">City</label>
                <input id="edit-city" name="city" placeholder="City / District"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Locality</label>
                <input id="edit-locality" name="locality" placeholder="Locality / Town"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="md:col-span-2 space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">House / Building</label>
                <input id="edit-house" name="house" placeholder="House No, Building Name"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="md:col-span-2 space-y-1">
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Area / Street</label>
                <input id="edit-area" name="area" placeholder="Area, Colony, Sector, Village"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 bg-gray-50 focus:bg-white transition">
              </div>

              <div class="md:col-span-2 flex items-center gap-2 pt-2">
                <input type="checkbox" id="edit-isDefault" name="isDefault" value="true"
                  class="w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-indigo-500 focus:ring-2 cursor-pointer">
                <label for="edit-isDefault" class="text-sm font-bold text-gray-700 cursor-pointer">Set as default address</label>
              </div>

              <div class="md:col-span-2 flex gap-3 pt-2 border-t">
                <button type="button" onclick="closeEditModal()"
                  class="flex-1 py-3 border rounded-xl font-bold hover:bg-gray-50 transition">Cancel</button>
                <button type="submit"
                  class="flex-1 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-100">Update
                  Address</button>
              </div>
            </form>
      </div>
    </div>
  </div>

  <script src="/js/validation.js"></script>
  <script src="/js/user/address/addressValidation.js"></script>
  <script src="/js/user/address/pincodeAutofill.js"></script>
  <script src="/js/user/address/addressHelpers.js"></script>
  <script>
    // ── Modal helpers ────────────────────────────────────────────────────────
    function _showModal(id) {
      const overlay = document.getElementById(id);
      const box     = overlay.querySelector('[data-modal-box]');
      overlay.classList.remove('hidden');
      // Trigger transition on next frame
      requestAnimationFrame(() => {
        overlay.classList.add('modal-visible');
        if (box) box.classList.add('modal-box-visible');
      });
    }

    function _hideModal(id) {
      const overlay = document.getElementById(id);
      const box     = overlay.querySelector('[data-modal-box]');
      overlay.classList.remove('modal-visible');
      if (box) box.classList.remove('modal-box-visible');
      setTimeout(() => overlay.classList.add('hidden'), 250);
    }

    function _resetForm(formId) {
      const form = document.getElementById(formId);
      if (!form) return;
      Array.from(form.elements).forEach(el => ValidationHelper.clearError(el));
      const errBox = document.getElementById(formId === 'addAddressForm' ? 'addModalError' : 'editModalError');
      if (errBox) errBox.classList.add('hidden');
    }

    // ---- Add Modal ----
    function openAddModal()  { _showModal('addAddressModal'); }
    function closeAddModal() { _hideModal('addAddressModal'); _resetForm('addAddressForm'); }

    // ---- Edit Modal ----
    function openEditModal(btn) {
      const id = btn.dataset.id;
      document.getElementById('editAddressForm').dataset.action = `/account/addresses/${id}`;
      document.getElementById('edit-fullName').value  = btn.dataset.fullname  || '';
      document.getElementById('edit-phone').value     = btn.dataset.phone     || '';
      document.getElementById('edit-pincode').value   = btn.dataset.pincode   || '';
      document.getElementById('edit-state').value     = btn.dataset.state     || '';
      document.getElementById('edit-city').value      = btn.dataset.city      || '';
      document.getElementById('edit-locality').value  = btn.dataset.locality  || '';
      document.getElementById('edit-house').value     = btn.dataset.house     || '';
      document.getElementById('edit-area').value      = btn.dataset.area      || '';
      document.getElementById('edit-isDefault').checked = btn.dataset.isdefault === 'true';
      _resetForm('editAddressForm');
      _showModal('editAddressModal');
    }
    function closeEditModal() { _hideModal('editAddressModal'); }

    // Close on backdrop click
    ['addAddressModal', 'editAddressModal'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('click', e => { if (e.target === el) el.id === 'addAddressModal' ? closeAddModal() : closeEditModal(); });
    });

    // Auto-open on backend error
    <% if (typeof modalType !== "undefined" && modalType === "add") { %>
      openAddModal();
    <% } %>
    <% if (typeof modalType !== "undefined" && modalType === "edit") { %>
      <% if (typeof editAddressData !== "undefined" && editAddressData) { %>
        document.getElementById('editAddressForm').dataset.action = `/account/addresses/<%= editAddressData._id %>`;
        document.getElementById('edit-fullName').value  = `<%= editAddressData.fullName  || '' %>`;
        document.getElementById('edit-phone').value     = `<%= editAddressData.phone     || '' %>`;
        document.getElementById('edit-pincode').value   = `<%= editAddressData.pincode   || '' %>`;
        document.getElementById('edit-state').value     = `<%= editAddressData.state     || '' %>`;
        document.getElementById('edit-city').value      = `<%= editAddressData.city      || '' %>`;
        document.getElementById('edit-locality').value  = `<%= editAddressData.locality  || '' %>`;
        document.getElementById('edit-house').value     = `<%= editAddressData.house     || '' %>`;
        document.getElementById('edit-area').value      = `<%= editAddressData.area      || '' %>`;
        document.getElementById('edit-isDefault').checked = <%= !!editAddressData.isDefault %>;
      <% } %>
      _showModal('editAddressModal');
    <% } %>
  </script>

  <style>
    /* Modal transition */
    #addAddressModal, #editAddressModal {
      opacity: 0;
      transition: opacity 0.2s ease;
      pointer-events: none;
    }
    #addAddressModal.modal-visible, #editAddressModal.modal-visible {
      opacity: 1;
      pointer-events: auto;
    }
    #addAddressModal.hidden, #editAddressModal.hidden {
      opacity: 0;
    }
    [data-modal-box] {
      transform: scale(0.95) translateY(8px);
      transition: transform 0.25s cubic-bezier(.22,.68,0,1.2);
    }
    .modal-box-visible {
      transform: scale(1) translateY(0) !important;
    }
    /* Green flash on autofill */
    .bg-indigo-50 { background-color: #eef2ff; transition: background-color 0.4s ease; }
  </style>
