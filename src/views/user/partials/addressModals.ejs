  <!-- ===================== ADD ADDRESS MODAL ===================== -->
  <div id="addAddressModal"
    class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[110] flex items-center justify-center p-4">
    <div data-modal-box class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col transform transition-all duration-300">
      <div class="px-8 py-6 border-b border-gray-100 flex justify-between items-center bg-white/80 sticky top-0 z-10">
        <div>
          <h3 class="text-2xl font-black text-gray-900">Add New Address</h3>
          <p class="text-xs text-gray-400 font-bold mt-1">Please enter your delivery details</p>
        </div>
        <button type="button" onclick="closeAddModal()" class="text-gray-400 hover:text-gray-900 hover:bg-gray-100 p-2 rounded-full transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="overflow-y-auto flex-1 bg-gray-50/30">
        <% if (typeof modalError !=="undefined" && modalError && (typeof modalType==="undefined" || modalType==="add" ))
          { %>
          <div class="mx-8 mt-6 p-4 text-sm font-bold rounded-2xl bg-red-50 text-red-700 border border-red-100 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <%= modalError %>
          </div>
          <% } %>
          <div id="addModalError" class="hidden mx-8 mt-6 p-4 text-sm font-bold rounded-2xl bg-red-50 text-red-700 border border-red-100 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span class="error-text"></span>
          </div>

            <form id="addAddressForm" class="p-8 grid md:grid-cols-2 gap-x-6 gap-y-5">
              <div class="space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">Full Name</label>
                <input id="add-fullName" name="fullName" placeholder="e.g. Rahul Sharma"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.fullName || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">Phone Number</label>
                <input id="add-phone" name="phone" placeholder="10-digit mobile number" inputmode="numeric" maxlength="10"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.phone || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">Pincode</label>
                <input id="add-pincode" name="pincode" placeholder="6-digit pincode" inputmode="numeric" maxlength="6"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.pincode || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">State</label>
                <input id="add-state" name="state" placeholder="Auto-filled from pincode"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.state || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">City</label>
                <input id="add-city" name="city" placeholder="Auto-filled from pincode"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.city || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">Locality</label>
                <input id="add-locality" name="locality" placeholder="Locality / Town / Area"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.locality || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="md:col-span-2 space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">House / Building</label>
                <input id="add-house" name="house" placeholder="e.g. Flat 4B, Sunrise Apartments"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.house || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="md:col-span-2 space-y-1.5 relative group">
                <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider ml-1 group-focus-within:text-indigo-600 transition-colors">Area / Street</label>
                <input id="add-area" name="area" placeholder="e.g. MG Road, Sector 14, Andheri West"
                  value="<%= (typeof addAddressData !== 'undefined' && addAddressData) ? addAddressData.area || '' : '' %>"
                  class="w-full border-2 border-gray-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-gray-900 outline-none focus:border-indigo-500 focus:bg-white bg-gray-50/50 transition-all placeholder:text-gray-400 hover:border-gray-300">
              </div>

              <div class="md:col-span-2 flex items-center gap-3 pt-3 pb-1">
                <div class="relative flex items-start">
                  <div class="flex items-center h-5">
                    <input type="checkbox" id="add-isDefault" name="isDefault"
                      <%= (typeof addAddressData !== 'undefined' && addAddressData && addAddressData.isDefault) ? 'checked' : '' %>
                      class="w-5 h-5 text-indigo-600 bg-gray-100 border-2 border-gray-300 rounded focus:ring-indigo-500 focus:ring-2 cursor-pointer transition-colors">
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="add-isDefault" class="font-bold text-gray-900 cursor-pointer">Set as default address</label>
                    <p class="text-xs text-gray-500 font-medium mt-0.5">This address will be selected by default for future orders.</p>
                  </div>
                </div>
              </div>

              <div class="md:col-span-2 flex gap-4 pt-6 border-t border-gray-100 mt-2">
                <button type="button" onclick="closeAddModal()"
                  class="flex-1 py-4 border-2 border-gray-200 text-gray-700 rounded-xl font-bold hover:bg-gray-50 transition-colors">Cancel</button>
                <button type="submit" id="addAddressSubmitBtn"
                  class="flex-1 py-4 bg-indigo-600 text-white rounded-xl font-black hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 active:scale-[0.98] flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                  Save Address
                </button>
              </div>
            </form>
      </div>
    </div>
  </div>

  <!-- ===================== EDIT ADDRESS MODAL ===================== -->
