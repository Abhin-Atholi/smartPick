<%- include("../partials/navbar") %>

<section class="max-w-6xl mx-auto px-4 py-8">
  <%- include("../partials/accountHeader", { breadcrumb: 'Saved Addresses' }) %>

  <div class="grid lg:grid-cols-[280px_1fr] gap-6">
    <aside>
      <%- include("../partials/accountSidebar", { active: "addresses" }) %>
    </aside>

    <main class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden flex flex-col">

      <!-- ── Sticky Header ──────────────────────────────────────────────── -->
      <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center flex-shrink-0">
        <div>
          <h2 class="text-xl font-black text-gray-900">Saved Addresses</h2>
          <p class="text-xs text-gray-400 font-semibold mt-0.5">
            <%= (addresses || []).length %> address<%= (addresses || []).length !== 1 ? 'es' : '' %> saved
          </p>
        </div>
        <button onclick="openAddModal()"
          class="flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 transition-all active:scale-95 shadow-sm shadow-indigo-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Address
        </button>
      </div>

      <!-- ── Flash Message ──────────────────────────────────────────────── -->
      <% if (typeof msg !== "undefined" && msg) { %>
        <div class="mx-6 mt-5 px-4 py-3 text-sm font-bold rounded-xl flex items-center gap-2
          <%= msg.includes('successfully') || msg.includes('deleted') ? 'bg-green-50 text-green-700 border border-green-100' : 'bg-red-50 text-red-700 border border-red-100' %>">
          <% if (msg.includes('successfully') || msg.includes('deleted')) { %>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          <% } else { %>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          <% } %>
          <%= msg %>
        </div>
      <% } %>

      <!-- ── Empty State ────────────────────────────────────────────────── -->
      <% if ((addresses || []).length === 0) { %>
        <div class="flex flex-col items-center justify-center py-20 text-center px-6">
          <div class="w-16 h-16 bg-indigo-50 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.5" class="text-indigo-400" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <p class="text-gray-800 font-black text-base">No addresses saved yet</p>
          <p class="text-gray-400 text-sm font-semibold mt-1 mb-5">Add a delivery address to get started.</p>
          <button onclick="openAddModal()"
            class="px-6 py-2.5 bg-indigo-600 text-white font-bold text-sm rounded-xl hover:bg-indigo-700 transition-all active:scale-95 shadow-sm">
            + Add your first address
          </button>
        </div>

      <% } else { %>

        <!-- ── Scrollable Cards ──────────────────────────────────────────── -->
        <div class="flex-1 overflow-y-auto p-6 space-y-3 bg-gray-50/40" style="max-height: 68vh;">
          <% (addresses || []).forEach(a => { %>
            <div class="relative group bg-white border-2 rounded-2xl p-5 transition-all duration-200
              <%= a.isDefault
                    ? 'border-indigo-400 shadow-md shadow-indigo-100/60'
                    : 'border-gray-200 hover:border-indigo-200 hover:shadow-sm' %>">

              <!-- Name + Default badge + Actions -->
              <div class="flex justify-between items-start gap-3 mb-3">
                <div class="flex items-center gap-2 flex-wrap min-w-0">
                  <span class="font-black text-gray-900 text-base truncate"><%= a.fullName %></span>
                  <% if (a.isDefault) { %>
                    <span class="flex-shrink-0 px-2 py-0.5 rounded-md text-[10px] font-black bg-indigo-100 text-indigo-700 uppercase tracking-widest border border-indigo-200">Default</span>
                  <% } %>
                </div>
                <div class="flex items-center gap-1 flex-shrink-0">
                  <!-- Edit -->
                  <button onclick="openEditModal(this)"
                    data-id="<%= a._id %>"
                    data-fullname="<%= a.fullName %>"
                    data-phone="<%= a.phone %>"
                    data-pincode="<%= a.pincode %>"
                    data-state="<%= a.state %>"
                    data-city="<%= a.city %>"
                    data-locality="<%= a.locality %>"
                    data-house="<%= a.house %>"
                    data-area="<%= a.area %>"
                    data-isdefault="<%= a.isDefault ? 'true' : 'false' %>"
                    class="p-2 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all"
                    title="Edit address">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                  </button>
                  <!-- Delete -->
                  <button onclick="confirmDelete(event, '<%= a._id %>')"
                    class="p-2 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all"
                    title="Delete address">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Phone -->
              <p class="text-sm font-bold text-gray-500 mb-3 flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.11 12 19.79 19.79 0 0 1 1.05 3.4 2 2 0 0 1 3 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <%= a.phone %>
              </p>

              <!-- Address text -->
              <p class="text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-3">
                <span class="font-semibold text-gray-800"><%= a.house %></span><% if (a.area) { %>, <%= a.area %><% } %><br>
                <% if (a.locality) { %><%= a.locality %>, <% } %><%= a.city %><br>
                <%= a.state %> — <span class="font-black text-gray-900"><%= a.pincode %></span>
              </p>

              <!-- Default check-dot (bottom-right) -->
              <% if (a.isDefault) { %>
                <div class="absolute right-4 bottom-4 w-5 h-5 rounded-full bg-indigo-600 flex items-center justify-center shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none"
                    stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>

        <!-- ── Sticky Footer ──────────────────────────────────────────────── -->
        <div class="px-6 py-4 bg-white border-t border-gray-100 flex-shrink-0">
          <button onclick="openAddModal()"
            class="w-full py-3 bg-indigo-50 text-indigo-700 text-sm font-black rounded-xl hover:bg-indigo-100 transition-all border border-indigo-200 flex justify-center items-center gap-2 active:scale-[0.99]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add New Address
          </button>
        </div>

      <% } %>
    </main>
  </div>
</section>

<%- include("../partials/footer") %>
<%- include("../partials/drawer") %>
<%- include("../partials/addressModals") %>