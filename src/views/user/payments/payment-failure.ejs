<%- include("../partials/navbar") %>

<style>
    @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulseRing {
        0%   { transform: scale(1); opacity: 0.6; }
        100% { transform: scale(1.6); opacity: 0; }
    }
    .fade-up { animation: fadeSlideUp 0.5s cubic-bezier(.22,1,.36,1) both; }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.22s; }
    .delay-3 { animation-delay: 0.36s; }
    .pulse-ring {
        animation: pulseRing 1.8s ease-out infinite;
    }

    /* Countdown digit style */
    #countdownHUD {
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.03em;
    }

    /* Expired section hidden by default */
    #expiredSection { display: none; }
    #retrySection  { display: block; }
</style>

<main class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-12 px-4 flex items-center justify-center">
    <div class="max-w-md w-full mx-auto space-y-5">

        <!-- ── Hero ─────────────────────────────────────────────────────── -->
        <div class="text-center fade-up">
            <!-- Amber warning mark -->
            <div class="w-24 h-24 mx-auto mb-5 relative flex items-center justify-center">
                <div class="absolute inset-0 rounded-full bg-amber-100 pulse-ring"></div>
                <div class="relative w-24 h-24 bg-amber-100 rounded-full flex items-center justify-center">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d97706"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
            </div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-1.5" id="pageTitle">Payment Incomplete</h1>
            <p class="text-gray-500 font-medium text-sm px-4" id="statusMessage">
                Your order was not completed. You can retry before the session expires.
            </p>
        </div>

        <!-- ── RETRY SECTION ─────────────────────────────────────────────── -->
        <div id="retrySection" class="space-y-4 fade-up delay-1">

            <!-- Countdown Card -->
            <div class="bg-white border border-amber-100 rounded-3xl shadow-sm p-6 text-center">
                <p class="text-xs font-black text-amber-500 uppercase tracking-widest mb-2">Session Expires In</p>
                <div id="countdownHUD" class="text-5xl font-black text-gray-900 mb-3">05:00</div>
                <p class="text-xs text-gray-400 font-semibold">Order <span class="font-black text-gray-600">#<%= order.orderId %></span></p>

                <!-- Progress Bar -->
                <div class="mt-4 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div id="progressBar" class="h-full bg-amber-400 rounded-full transition-all duration-1000" style="width: 100%"></div>
                </div>
            </div>

            <!-- Failed Attempts -->
            <% if (order.paymentDetails?.failedAttempts > 0) { %>
            <div class="flex items-center gap-3 px-4 py-3 bg-red-50/60 border border-red-100 rounded-2xl">
                <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                    <span class="text-xs font-black text-red-600"><%= order.paymentDetails.failedAttempts %></span>
                </div>
                <p class="text-xs text-red-600 font-semibold">
                    Payment failed <%= order.paymentDetails.failedAttempts %> time<%= order.paymentDetails.failedAttempts > 1 ? 's' : '' %>. Please check your payment details before retrying.
                </p>
            </div>
            <% } %>

            <!-- Action Buttons -->
            <div class="space-y-3">
                <button id="retryBtn" onclick="retryPayment()"
                    class="w-full py-4 bg-gray-900 hover:bg-black text-white rounded-2xl font-black text-sm flex items-center justify-center gap-2 transition-colors active:scale-95 shadow-lg shadow-gray-200">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 .49-4.65L1 10"></path></svg>
                    Retry Payment
                </button>
                <a id="cancelBtn" href="/checkout"
                    class="w-full py-4 bg-white border border-gray-200 text-gray-700 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-gray-50 transition-colors active:scale-95">
                    Choose Another Payment Method
                </a>
            </div>
        </div>

        <!-- ── EXPIRED SECTION ─────────────────────────────────────────── -->
        <div id="expiredSection" class="space-y-4 fade-up delay-1">
            <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-6 text-center">
                <div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-4 flex items-center justify-center">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-gray-400" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <p class="text-sm font-bold text-gray-700 mb-1">Session Expired</p>
                <p class="text-xs text-gray-400 font-medium" id="expiredMessage">Your items have been safely restored to your cart.</p>

                <!-- Partial restore warning badge — shown by JS if wasPartial=true -->
                <div id="partialRestoreBadge" class="hidden mt-4 flex items-start gap-2.5 text-left bg-amber-50 border border-amber-100 rounded-2xl px-4 py-3">
                    <svg class="flex-shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <p class="text-xs text-amber-700 font-semibold" id="partialRestoreMsg">
                        Some items were restored with reduced quantities due to stock changes.
                    </p>
                </div>
            </div>
            <div class="space-y-3">
                <a id="returnToCartBtn" href="/cart"
                    class="w-full py-4 bg-gray-900 hover:bg-black text-white rounded-2xl font-black text-sm flex items-center justify-center gap-2 transition-colors active:scale-95 shadow-lg shadow-gray-200">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    Return to Cart
                </a>
                <a href="/checkout"
                    class="w-full py-4 bg-white border border-gray-200 text-gray-700 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-gray-50 transition-colors active:scale-95">
                    Checkout Again
                </a>
            </div>
        </div>

        <a href="/products" class="w-full py-3 text-gray-400 font-bold text-sm hover:text-gray-700 transition-colors flex items-center justify-center fade-up delay-3">
            Continue Shopping
        </a>

    </div>
</main>

<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/payment/paymentUIManager.js"></script>

<script>
    const orderId      = "<%= order._id %>";
    const expiryTimeIso = "<%= order.paymentDetails?.retryExpiryTime?.toISOString() || '' %>";
    const expiryTime   = expiryTimeIso ? new Date(expiryTimeIso).getTime() : 0;
    const totalDuration = 5 * 60 * 1000; // 5 min

    const countdownHUD   = document.getElementById('countdownHUD');
    const progressBar    = document.getElementById('progressBar');
    const retryBtn       = document.getElementById('retryBtn');
    const retrySection   = document.getElementById('retrySection');
    const expiredSection = document.getElementById('expiredSection');
    const statusMessage  = document.getElementById('statusMessage');
    const pageTitle      = document.getElementById('pageTitle');

    function showExpiredState(summary) {
        retrySection.style.display = 'none';
        expiredSection.style.display = 'block';
        pageTitle.textContent = 'Session Expired';
        statusMessage.textContent = 'This payment session expired.';

        // Show partial restore badge if applicable
        if (summary && summary.wasPartial) {
            const badge = document.getElementById('partialRestoreBadge');
            const msg   = document.getElementById('partialRestoreMsg');
            if (badge) badge.classList.remove('hidden');
            if (msg) {
                const parts = [];
                if (summary.partialRestores > 0) parts.push(`${summary.partialRestores} item(s) restored with reduced quantity`);
                if (summary.skippedItems > 0) parts.push(`${summary.skippedItems} item(s) unavailable`);
                msg.textContent = parts.join(' · ') + ' due to stock changes.';
            }
        } else {
            const expMsg = document.getElementById('expiredMessage');
            if (expMsg) expMsg.textContent = summary?.restoredItems > 0
                ? `${summary.restoredItems} item(s) were safely restored to your cart.`
                : 'Your items have been safely restored to your cart.';
        }
    }

    // ── Polling ────────────────────────────────────────────────────────────
    const pollingInterval = setInterval(async () => {
        try {
            const res = await axios.get(`/order/status/${orderId}`);
            if (res.data.isExpired) {
                clearInterval(pollingInterval);
                clearInterval(timerInterval);
                showExpiredState(res.data.cartRestorationSummary);
            }
        } catch (e) { /* silent */ }
    }, 8000);

    // ── Countdown Timer ────────────────────────────────────────────────────
    const timerInterval = setInterval(() => {
        if (!expiryTime) return;
        const now      = Date.now();
        const distance = expiryTime - now;

        if (distance <= 0) {
            clearInterval(timerInterval);
            countdownHUD.textContent = '00:00';
            progressBar.style.width = '0%';
            // Fetch summary from server before showing expired state
            (async () => {
                try {
                    const res = await axios.get(`/order/status/${orderId}`);
                    showExpiredState(res.data?.cartRestorationSummary);
                } catch {
                    showExpiredState(null);
                }
            })();
            return;
        }

        const mins = Math.floor(distance / 60000);
        const secs = Math.floor((distance % 60000) / 1000);
        countdownHUD.textContent = (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;

        // Update progress bar
        const pct = Math.max(0, Math.min(100, (distance / totalDuration) * 100));
        progressBar.style.width = pct + '%';
        // Colour shift as time runs low
        if (pct < 30) {
            progressBar.classList.replace('bg-amber-400', 'bg-red-500');
        }

    }, 1000);

    // ── Retry Payment ──────────────────────────────────────────────────────
    async function retryPayment() {
        if (retryBtn.disabled) return;
        if (window.paymentUI) window.paymentUI.lockButton(retryBtn, 'Opening Payment...');

        try {
            const res = await axios.post('/payment/retry', { orderId });

            if (res.data.success) {
                const options = {
                    key: res.data.key,
                    amount: res.data.amount * 100,
                    currency: 'INR',
                    name: 'SmartPick',
                    description: 'Retry Payment',
                    order_id: res.data.razorpayOrderId,
                    handler: async function (paymentResponse) {
                        if (window.paymentUI) await window.paymentUI.showOverlay('razorpay');
                        try {
                            const verifyRes = await axios.post('/payment/verify', {
                                orderId,
                                razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                razorpay_order_id:   paymentResponse.razorpay_order_id,
                                razorpay_signature:  paymentResponse.razorpay_signature
                            });
                            if (verifyRes.data.success) {
                                if (window.paymentUI) {
                                    await window.paymentUI.showSuccess(verifyRes.data.redirectUrl);
                                } else {
                                    window.location.href = verifyRes.data.redirectUrl;
                                }
                            }
                        } catch (err) {
                            console.error(err);
                            if (window.paymentUI) {
                                await window.paymentUI.hideOverlay(true);
                                await window.paymentUI.showOverlay('error', { message: 'Payment verification failed. Please try again.' });
                            }
                            window.paymentUI.unlockButton(retryBtn);
                        }
                    },
                    modal: {
                        ondismiss: async function () {
                            await axios.post('/payment/failure', { orderId });
                            window.location.reload();
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', async function () {
                    await axios.post('/payment/failure', { orderId });
                    window.location.reload();
                });
                rzp.open();
                // Unlock btn once Razorpay modal is open
                if (window.paymentUI) window.paymentUI.unlockButton(retryBtn);
            }

        } catch (err) {
            console.error(err);
            const errMsg = err.response?.data?.message || 'Could not initiate retry. Session may have expired.';
            if (window.paymentUI) {
                await window.paymentUI.hideOverlay(true);
                await window.paymentUI.showOverlay('error', { message: errMsg });
            }
            if (errMsg === 'Payment session expired') {
                await new Promise(r => setTimeout(r, 2000));
                window.location.reload();
            }
        } finally {
            if (window.paymentUI) window.paymentUI.unlockButton(retryBtn);
        }
    }
</script>

<%- include("../partials/footer") %>
<%- include("../partials/drawer") %>
