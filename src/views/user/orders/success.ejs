<%- include("../partials/navbar") %>

<style>
    @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes popIn {
        0%   { transform: scale(0); opacity: 0; }
        70%  { transform: scale(1.08); opacity: 1; }
        100% { transform: scale(1);   opacity: 1; }
    }
    @keyframes drawCheck {
        to { stroke-dashoffset: 0; }
    }
    @keyframes glowPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.20); }
        50%       { box-shadow: 0 0 0 18px rgba(34,197,94,0); }
    }
    .fade-up { animation: fadeSlideUp 0.55s cubic-bezier(.22,1,.36,1) both; }
    .delay-1 { animation-delay: 0.08s; }
    .delay-2 { animation-delay: 0.18s; }
    .delay-3 { animation-delay: 0.30s; }
    .delay-4 { animation-delay: 0.44s; }
    .check-ring {
        animation: popIn 0.45s cubic-bezier(.34,1.56,.64,1) 0.15s both, glowPulse 2s 0.7s ease-in-out infinite;
    }
    .check-svg {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
        animation: drawCheck 0.55s ease-out 0.52s forwards;
    }
    .item-thumb {
        aspect-ratio: 1;
        object-fit: cover;
    }
</style>

<main class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-12 px-4">
    <div class="max-w-xl mx-auto space-y-5">

        <!-- ── Hero ────────────────────────────────────────────────────── -->
        <div class="text-center fade-up">
            <!-- Animated check -->
            <div class="w-24 h-24 mx-auto mb-5 bg-green-100 rounded-full flex items-center justify-center check-ring">
                <svg class="check-svg" width="44" height="44" viewBox="0 0 24 24" fill="none"
                    stroke="#16a34a" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight mb-1.5">Order Confirmed</h1>
            <p class="text-gray-500 font-medium text-sm">Your order has been placed successfully. We'll start processing it right away.</p>
        </div>

        <% if (typeof order !== 'undefined' && order) { %>

        <!-- ── Order Summary ───────────────────────────────────────────── -->
        <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-6 fade-up delay-1">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-black text-gray-900 uppercase tracking-widest">Order Summary</h2>
                <span class="text-xs font-bold text-green-700 bg-green-50 border border-green-100 px-2.5 py-1 rounded-full">
                    <%= order.paymentStatus === 'Paid' ? 'Paid' : 'Confirmed' %>
                </span>
            </div>
            <div class="space-y-3">
                <!-- Order ID + Date -->
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-400 font-semibold">Order ID</span>
                    <span class="font-black text-gray-900 tracking-tight"><%= order.orderId %></span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-400 font-semibold">Date</span>
                    <span class="font-bold text-gray-700">
                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </span>
                </div>
                <!-- Payment -->
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-400 font-semibold">Payment</span>
                    <span class="font-bold text-gray-700 flex items-center gap-1.5">
                        <% if (order.paymentMethod === 'Razorpay') { %>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-blue-500"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                        <% } else if (order.paymentMethod === 'Wallet') { %>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-indigo-500"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
                        <% } else { %>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-green-500"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        <% } %>
                        <%= order.paymentMethod %>
                    </span>
                </div>
                <!-- Total -->
                <div class="flex justify-between items-center text-sm pt-3 border-t border-gray-100">
                    <span class="text-gray-500 font-black">Total Paid</span>
                    <span class="font-black text-gray-900 text-base">₹<%= order.totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                </div>
            </div>

            <!-- Delivery Address -->
            <div class="mt-4 pt-4 border-t border-gray-100">
                <p class="text-xs font-black text-gray-400 uppercase tracking-widest mb-1.5">Delivering To</p>
                <p class="text-sm font-bold text-gray-900"><%= order.shippingAddress.fullName %></p>
                <p class="text-xs text-gray-500 font-medium leading-relaxed mt-0.5">
                    <%= order.shippingAddress.addressLine1 %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <%= order.shippingAddress.postalCode %>
                </p>
            </div>
        </div>

        <!-- ── Items Preview ──────────────────────────────────────────── -->
        <% if (order.items && order.items.length > 0) { %>
        <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-6 fade-up delay-2">
            <h2 class="text-sm font-black text-gray-900 uppercase tracking-widest mb-4">
                Items (<%= order.items.reduce((a, i) => a + i.quantity, 0) %>)
            </h2>
            <div class="space-y-3">
                <% order.items.forEach(item => { %>
                <% const product = item.product; %>
                <% const img = (product && product.colorOptions && product.colorOptions.length > 0 && product.colorOptions[0].images && product.colorOptions[0].images.length > 0) ? product.colorOptions[0].images[0] : null; %>
                <div class="flex items-center gap-3">
                    <% if (product?._id) { %>
                      <a href="/products/details/<%= product._id %>" class="w-12 h-12 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0 block hover:opacity-90 transition-opacity">
                        <% if (img) { %>
                          <img src="<%= img %>" alt="<%= product?.name || 'Product' %>" class="item-thumb w-full h-full object-cover">
                        <% } else { %>
                          <div class="w-full h-full flex items-center justify-center">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gray-300"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="m9 9 6 6m0-6-6 6"></path></svg>
                          </div>
                        <% } %>
                      </a>
                    <% } else { %>
                      <% if (img) { %>
                        <img src="<%= img %>" alt="<%= product?.name || 'Product' %>" class="item-thumb w-12 h-12 rounded-xl object-cover bg-gray-100 flex-shrink-0">
                      <% } else { %>
                        <div class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gray-300"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="m9 9 6 6m0-6-6 6"></path></svg>
                        </div>
                      <% } %>
                    <% } %>
                    <div class="flex-1 min-w-0">
                        <% if (product?._id) { %>
                          <a href="/products/details/<%= product._id %>" class="hover:text-indigo-600 transition-colors block">
                            <p class="text-sm font-bold text-gray-900 truncate"><%= product?.name || 'Product' %></p>
                          </a>
                        <% } else { %>
                          <p class="text-sm font-bold text-gray-900 truncate"><%= product?.name || 'Product' %></p>
                        <% } %>
                        <p class="text-xs text-gray-400 font-semibold mt-0.5"><%= item.color %> · <%= item.size %> · Qty <%= item.quantity %></p>
                    </div>
                    <p class="text-sm font-black text-gray-800 flex-shrink-0">₹<%= item.totalPrice.toLocaleString('en-IN') %></p>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- ── CTA Buttons ──────────────────────────────────────────────── -->
        <div class="space-y-3 fade-up delay-3">
            <a href="<%= orderId ? `/orders/${orderId}` : '/orders' %>"
                class="w-full py-4 bg-gray-900 hover:bg-black text-white rounded-2xl font-black text-sm flex items-center justify-center gap-2 transition-colors active:scale-95 shadow-lg shadow-gray-200">
                Track Order
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>

            <div class="grid grid-cols-1">
                <a href="/products" class="py-3.5 bg-white border border-gray-200 text-gray-700 rounded-2xl font-bold text-sm flex items-center justify-center gap-1.5 hover:bg-gray-50 transition-colors active:scale-95 w-full">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    Shop More
                </a>
            </div>
        </div>

        <% } else { %>
        <!-- Fallback: no order data -->
        <div class="bg-white border border-gray-100 rounded-3xl shadow-sm p-8 text-center fade-up delay-1">
            <p class="text-gray-500 font-medium text-sm">Your order has been received. Check your orders page for details.</p>
            <a href="/orders" class="mt-5 inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-2xl font-black text-sm hover:bg-black transition">
                View Orders
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
        </div>
        <% } %>

        <!-- Footnote -->
        <p class="text-center text-xs text-gray-400 font-medium pb-4 fade-up delay-4">
            A confirmation email has been sent to your registered address.
        </p>

    </div>
</main>

<%- include("../partials/footer") %>
<%- include("../partials/drawer") %>
