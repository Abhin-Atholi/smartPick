<div class="min-h-screen bg-gray-100 flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 px-6 py-8">

    <!-- Icon -->
    <div class="w-10 h-10 mx-auto rounded-xl bg-gray-200 grid place-items-center mb-4">
      <span>👤</span>
    </div>

    <!-- Title -->
    <h1 class="text-xl font-black text-center">Create Account</h1>
    <p class="text-sm text-gray-500 text-center mt-1 mb-6">
      Join thousands of users shopping with us today
    </p>

<% if (locals.msg) { %>
  <% const isSuccess = msg.includes('successful') || msg.includes('✅'); %>
  <div id="error-message" class="<%= isSuccess ? 'bg-green-50 border-green-500' : 'bg-red-50 border-red-500' %> border-l-4 p-4 mb-6">
    <div class="flex">
      <div class="flex-shrink-0">
        <span class="<%= isSuccess ? 'text-green-500' : 'text-red-500' %>"><%- isSuccess ? '✅' : '⚠️' %></span>
      </div>
      <div class="ml-3">
        <p class="text-sm <%= isSuccess ? 'text-green-700' : 'text-red-700' %> font-medium">
          <%= msg.replace('✅', '').trim() %>
        </p>
      </div>
    </div>
  </div>
<% } %>

    <form action="/register" id="registrationForm" method="POST" class="space-y-4">

      <div>
        <label class="block text-sm font-semibold mb-1">Full Name</label>
        <input type="text" name="name" placeholder="John Doe" 
          class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm outline-none
                 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" value="<%=locals.name?name:'' %>">
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Email Address</label>
        <input type="text" name="email" placeholder="name@example.com" 
          class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm outline-none
                 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" value="<%=locals.email?email:''%>">
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Password</label>
        <div class="relative">
          <input type="password" name="password" id="password" placeholder="••••••••" 
            class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm outline-none
                   focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
          <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 focus:outline-none toggle-password" data-target="password">
            <svg class="w-4 h-4 eye-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.352 7.088 7.423 4.75 12 4.75s8.648 2.338 9.964 6.928a1.012 1.012 0 0 1 0 .644c-1.316 4.908-5.387 7.246-12 7.246s-8.648-2.338-9.964-6.928Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <svg class="w-4 h-4 eye-slash-icon hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.822 7.822L21 21m-7.778-7.778-3.65-3.65m0 0a3 3 0 1 0 5.148 5.148m-5.148-5.148 3.65 3.65" />
            </svg>
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1">
          At least 8 characters.
        </p>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Confirm Password</label>
        <div class="relative">
          <input type="password" name="confirmPassword" id="confirmPassword" placeholder="••••••••" 
            class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm outline-none
                   focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
          <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 focus:outline-none toggle-password" data-target="confirmPassword">
            <svg class="w-4 h-4 eye-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.352 7.088 7.423 4.75 12 4.75s8.648 2.338 9.964 6.928a1.012 1.012 0 0 1 0 .644c-1.316 4.908-5.387 7.246-12 7.246s-8.648-2.338-9.964-6.928Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <svg class="w-4 h-4 eye-slash-icon hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.822 7.822L21 21m-7.778-7.778-3.65-3.65m0 0a3 3 0 1 0 5.148 5.148m-5.148-5.148 3.65 3.65" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Referral Code (optional) -->
      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-700">
          Referral Code <span class="text-gray-400 font-normal">(optional)</span>
        </label>
        <div class="relative">
          <input type="text" name="referralCode" id="referralCodeInput"
            placeholder="e.g. SPAB12CD"
            value="<%= locals.referralCode ? referralCode : '' %>"
            maxlength="10" autocomplete="off"
            class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm outline-none font-mono font-bold uppercase tracking-widest
                   focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all"
            style="text-transform:uppercase">
          <% if (locals.referralCode && referralCode) { %>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-green-500 text-xs font-bold">✓ Applied</span>
          <% } %>
        </div>
        <p class="text-xs text-gray-400 mt-1">Get ₹50 wallet credit when you use a friend's referral code.</p>
      </div>

      <button type="submit"
        class="w-full rounded-lg bg-indigo-600 text-white font-black py-2.5 text-sm
               shadow-md hover:bg-indigo-700 transition">
        Create Account
      </button>

      <div class="flex items-center gap-3 my-6">
      <div class="h-px bg-gray-200 flex-1"></div>
      <span class="text-xs text-gray-400">Or continue with</span>
      <div class="h-px bg-gray-200 flex-1"></div>
    </div>

    <button type="button" onclick="location.href='/auth/google'"
      class="w-full rounded-lg border border-gray-200 bg-white py-3 font-bold hover:bg-gray-50 transition flex items-center justify-center gap-2">
      <span class="w-5 h-5 rounded-full bg-gray-100 grid place-items-center font-black">G</span> Google
    </button>

      <p class="text-sm text-gray-600 text-center">
        Already have an account?
        <a href="/login" class="font-bold text-gray-900 hover:underline">Login</a>
      </p>
    </form>
    

  </div>

  <!-- Footer
  <div class="fixed bottom-6 left-0 right-0 text-center text-xs text-gray-400">
    © 2024 E-commerce Inc. All rights reserved.
  </div> -->
</div>

<script>
// Password Toggles
document.querySelectorAll('.toggle-password').forEach(button => {
    button.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);
        const eyeIcon = this.querySelector('.eye-icon');
        const eyeSlashIcon = this.querySelector('.eye-slash-icon');
        
        if (input.type === 'password') {
            input.type = 'text';
            eyeIcon.classList.add('hidden');
            eyeSlashIcon.classList.remove('hidden');
        } else {
            input.type = 'password';
            eyeIcon.classList.remove('hidden');
            eyeSlashIcon.classList.add('hidden');
        }
    });
});

// Auto-uppercase + no spaces for referral code input
const refInput = document.getElementById('referralCodeInput');
if (refInput) {
    refInput.addEventListener('input', function () {
        const pos = this.selectionStart;
        this.value = this.value.replace(/\s+/g, '').toUpperCase();
        this.setSelectionRange(pos, pos);
    });
}
</script>