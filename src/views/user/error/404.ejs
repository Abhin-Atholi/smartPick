<%- include("../partials/navbar") %>

<!-- ===== USER 404 PAGE ===== -->
<div class="min-h-[80vh] flex items-center justify-center px-4 py-20 relative overflow-hidden">

  <!-- Glowing ambient background blobs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-200/40 rounded-full blur-3xl -translate-y-1/2 pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-purple-200/40 rounded-full blur-3xl translate-y-1/2 pointer-events-none"></div>

  <div class="relative z-10 max-w-lg w-full text-center">

    <!-- Big 404 Number -->
    <div class="relative inline-block mb-6">
      <span class="text-[9rem] sm:text-[12rem] font-black leading-none text-transparent bg-clip-text bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-400 select-none">
        404
      </span>
      <!-- Floating badge -->
      <div class="absolute -top-2 -right-4 sm:-right-6 bg-indigo-600 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full shadow-lg shadow-indigo-300/50 rotate-12">
        Lost?
      </div>
    </div>

    <!-- Icon -->
    <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
           class="text-indigo-400">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="11" y1="8" x2="11" y2="11"/>
        <line x1="11" y1="14" x2="11.01" y2="14"/>
      </svg>
    </div>

    <!-- Copy -->
    <h1 class="text-2xl sm:text-3xl font-black text-slate-800 mb-3">Page Not Found</h1>
    <p class="text-gray-500 text-sm sm:text-base leading-relaxed mb-8">
      Looks like you wandered off the map. The page you're looking for doesn't exist, was moved, or was never here to begin with.
    </p>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/"
         id="btn-go-home"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 text-white font-black text-sm hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200 hover:shadow-indigo-300 hover:-translate-y-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Back to Home
      </a>
      <a href="/products"
         id="btn-browse-shop"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white border border-gray-200 text-slate-700 font-black text-sm hover:bg-gray-50 hover:border-indigo-200 transition-all hover:-translate-y-0.5 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        Browse Shop
      </a>
    </div>

    <!-- Tiny back link -->
    <button onclick="history.back()" id="btn-go-back-404"
            class="mt-6 text-xs text-gray-400 hover:text-indigo-500 font-bold underline underline-offset-4 transition-colors">
      ← Go back to previous page
    </button>

  </div>
</div>

<%- include("../partials/footer") %>
<%- include("../partials/drawer") %>
